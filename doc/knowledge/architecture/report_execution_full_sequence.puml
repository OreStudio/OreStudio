@startuml

title Report execution, full mode: selection, export, grid, import

actor Operator
participant "ores.scheduler" as sched
participant "ores.reporting" as rep
participant "ores.trading" as trade
participant "ores.marketdata" as mkt
participant "ores.ore\n(export/import)" as ore
database PostgreSQL as db
participant "workflow engine\n(ores.workflow)" as wf
participant "ores.compute" as comp
participant "NATS\nJetStream" as js
participant "wrapper node" as node
participant "ORE engine" as engine
participant "ores.storage" as store

== A schedule fires, exactly as in demo mode ==
sched -> rep : reporting.v1.ops.trigger_report_instance\n{report_definition_id, tenant_id, job_instance_id}
rep -> db : insert report instance (pending), resolve execution_mode = full
rep -> wf : workflow.v1.start\n{type, request_json: definition, instance, mode = full}
wf -> wf : build_steps(request_json)\nmode = full selects the long chain

== Preprocessing: the stages demo mode skips ==
wf -> rep : reporting.v1.report.gather-trades
rep -> trade : resolve the trades in the definition's scope\n(books and portfolios, as of the run date)
trade --> rep : trades
rep -> db : write the run's input bundle row
rep -> wf : workflow.v1.events.step-completed\n{step_index 0}

wf -> rep : reporting.v1.report.gather-market-data
rep -> mkt : resolve the curves, fixings and quotes\nthe selected trades need
mkt --> rep : market data
rep -> db : write the run's input bundle row
rep -> wf : workflow.v1.events.step-completed\n{step_index 1}

wf -> ore : ore.v1.report.export-inputs   (new stage)
ore -> db : read the run's trades and market data
ore -> ore : build Input/ore.xml, todaysmarket.xml,\npricingengine.xml, curveconfig.xml,\nconventions.xml, market.txt, fixings.txt
ore -> store : PUT /api/v1/storage/ores/reporting/runs/{instance}/ore-inputs.tar.gz
ore --> wf : workflow.v1.events.step-completed\n{step_index 2, input_uri}

== The common tail: identical in both modes ==
wf -> comp : compute.v1.report.submit\n{report_instance_id, tenant_id, correlation_id, tarball_uris}
comp -> db : insert batch (open), workunit, result (Unsent)
comp -> js : compute.v1.work.assignments.{tenant_id}.{platform_code}\n{result_id, workunit_id, package_uri, sha256,\ninput_uri, output_uri}
comp -> wf : workflow.v1.events.step-completed\n{step_index 3, batch_id}

js -> node : deliver assignment
node -> store : GET package_uri, GET input_uri
node -> engine : spawn (args: Input/ore.xml)
engine --> node : Output/  (npv.csv, flows.csv, curves.csv, ...)
node -> store : PUT /api/v1/storage/ores/compute/output/{result_id}.tar.gz
node -> comp : compute.v1.results.submit\n{result_id, host_id, output_uri, outcome}
comp -> db : result Done, workunit canonical, batch closed

wf -> rep : reporting.v1.report.collect-compute-results
rep -> comp : compute.v1.results.list (by report instance)
comp --> rep : result, output_uri
rep -> db : record the output location on the instance
rep -> wf : workflow.v1.events.step-completed\n{step_index 4, output_uri}

== Post-processing: the stage demo mode skips ==
wf -> ore : ore.v1.report.import-results   (new stage)
ore -> store : GET /api/v1/storage/ores/compute/output/{result_id}.tar.gz
store --> ore : Output/ archive
ore -> ore : parse the ORE result files
ore -> db : write the run's results\n(npv, cashflows, sensitivities, xva, ...)
ore --> wf : workflow.v1.events.step-completed\n{step_index 5}

wf -> rep : reporting.v1.report.finalise
rep -> db : instance completed
rep -> wf : workflow.v1.events.step-completed\n{step_index 6}

Operator -> rep : report_instances get\n(instance, state, results in the database)

@enduml
