{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "ores",
    "description": "GUI for Open Source Risk Engine (ORE)",
    "version-string": "0.0.25",
    "dependencies": [
        "openssl",
        {
            "name": "reflectcpp",
            "features": [ "xml", "msgpack" ]
        },
        {
            "name": "sqlgen",
            "features": [ "postgres" ]
        },
        "pugixml",
        "magic-enum",
        "boost-system",
        "boost-exception",
        "boost-graph",
        "boost-log",
        "boost-program-options",
        "boost-uuid",
        "boost-crc",
        "boost-circular-buffer",
        "boost-scope-exit",
        "boost-process",
        "boost-iostreams",
        "boost-beast",
        "boost-json",
        "boost-url",
        "jwt-cpp",
        "cli",
        "eigen3",
        "faker-cxx",
        "catch2",
        "libfort",
        "croncpp",
        "cnats",
        "libarchive",
        "sqlite3",
        "immer"
    ]
}
