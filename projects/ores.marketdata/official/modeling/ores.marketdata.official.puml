@startuml

title ores.marketdata.official Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace marketdata #F2F2F2 {
        namespace official #F2F2F2 {
            namespace domain #F2F2F2 {
                class published_rate <<struct>> {
                    +date : year_month_day
                    +base : string
                    +quote : string
                    +rate : string
                }

                class hosted_source <<struct>> {
                    +source_name : string
                    +provider_code : string
                    +frankfurter_key : string
                }

                class frankfurter_fetcher {
                    +currencies(string_view key) : expected<vector<string>, string>
                    +rates(string_view key, year_month_day from, year_month_day to) : expected<vector<published_rate>, string>
                }

                class source_feed {
                    -universe_ : set<string>
                    -demanded_ : set<string>
                    -last_sent_ : map<string, year_month_day>
                    +load_universe() : expected<void, string>
                    +announcement() : adapter_announce_request
                    +answer(const adapter_demand_request&) : adapter_demand_response
                    +demand(const adapter_demand_request&) : adapter_demand_response
                    +refresh(year_month_day today, publish_fn) : expected<size_t, string>
                }

                source_feed --> hosted_source
                source_feed --> frankfurter_fetcher
                frankfurter_fetcher ..> published_rate
            }

            namespace app #F2F2F2 {
                class official_adapter {
                    +subscribe() : vector<subscription>
                    +start() : void
                    +stop() : void
                }

                class application {
                    +run(io_context&, const options&) : awaitable<void>
                }

                application --> official_adapter
                official_adapter "1" *-- "many" ores::marketdata::official::domain::source_feed
            }
        }
    }
}


@enduml
