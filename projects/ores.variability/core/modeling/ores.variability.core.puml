                +count_settings() : uint32_t
                +get_setting_at_version(const boost::uuids::uuid& id, uint32_t version) : optional<domain::system_setting>
                +get_setting(const boost::uuids::uuid& id) : optional<domain::system_setting>
                +get_setting_by_name(const string& name) : optional<domain::system_setting>
                +get_settings(const vector<string>& ids) : vector<domain::system_setting>
                +save_setting(const domain::system_setting& setting) : void
                +save_settings(const vector<domain::system_setting>& settings) : void
                +delete_setting(const boost::uuids::uuid& id) : void
                +delete_settings(const vector<string>& ids) : void
                +get_setting_history(const string& key) : vector<domain::system_setting>
                -prepare_change(const messaging::system_setting_change& change, const ores::utility::domain::change_intent& intent, domain::system_setting& out) : ores::utility::domain::result
            }
            class system_settings_service {
                -cache_ : unordered_map<string, string>
                -ctx_ : database::context
                -tenant_id_ : string
                -party_id_ : string
                -repo_ : repository::system_setting_repository
                -lg() : [[nodiscard]] static auto&
                +get_all() : [[nodiscard]] vector<domain::system_setting>
                +get_bool(string_view name) : [[nodiscard]] bool
                +get_int(string_view name) : [[nodiscard]] int
                +get_string(string_view name) : [[nodiscard]] string
                +get(string_view name) : [[nodiscard]] optional<string>
                +refresh() : void
                +is_bootstrap_mode_enabled() : [[nodiscard]] bool
                +set_bootstrap_mode(bool enabled, string_view modified_by, string_view change_reason_code, string_view change_commentary) : void
                +is_user_signups_enabled() : [[nodiscard]] bool
                +is_signup_requires_authorization_enabled() : [[nodiscard]] bool
