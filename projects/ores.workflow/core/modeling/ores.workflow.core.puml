' --- manual: everything below this line is hand-authored; the script preserves it ---

' The automated pass reads data members, so a class whose content is methods
' arrives as an empty box and a facet of free functions does not arrive at all.
' This pass fills those boxes with the API and draws the seams the automated pass
' cannot see: the composition point, the registry, and the state maps.
'
' Fully-qualified class names rather than a reopened namespace block: declaring a
' namespace a second time creates a second package rather than merging into the
' first. Redeclaring a class merges its members into the box the automated pass
' already drew, so a refresh keeps both passes.
'
' Stereotypes split the two kinds. <<generated>> is written by the generator from
' the model; <<hand-written>> is logic the model cannot express, which here is the
' engine, the handlers and the aggregate registrar.

class ores::workflow::messaging::registrar <<hand-written>> {
    +{static} register_handlers(nats, ctx, signer, outbound_nats) : vector<subscription>
}

class ores::workflow::messaging::workflow_handler <<hand-written>> {
    +provision_parties(msg) : void
}

class ores::workflow::messaging::workflow_query_handler <<hand-written>> {
    +list_instances(msg) : void
    +get_steps(msg) : void
    +list_definitions(msg) : void
    +get_step_result(msg) : void
    -state_name(id : uuid) : string
}

' Four generated registrars, two per entity: a message registrar that subscribes
' the entity's CRUD subjects, and a history provider that answers the one generic
' history subject.

class ores::workflow::messaging::register_workflow_instance_handlers <<generated free function>> {
    +{static} register_workflow_instance_handlers(nats, ctx, signer) : vector<subscription>
}

class ores::workflow::messaging::register_workflow_step_handlers <<generated free function>> {
    +{static} register_workflow_step_handlers(nats, ctx, signer) : vector<subscription>
}

class ores::workflow::messaging::register_workflow_instance_history_provider <<generated free function>> {
    +{static} register_workflow_instance_history_provider(registry) : void
}

class ores::workflow::messaging::register_workflow_step_history_provider <<generated free function>> {
    +{static} register_workflow_step_history_provider(registry) : void
}

class ores::workflow::repository::workflow_instance_mapper <<generated>> {
    +{static} map(entity) : workflow_instance
    +{static} map(instance) : workflow_instance_entity
}

class ores::workflow::repository::workflow_instance_repository <<generated>> {
    +write(ctx, v : workflow_instance)
    +read_latest(ctx) : vector<workflow_instance>
    +read_latest(ctx, id : string) : vector<workflow_instance>
    +read_at_version(ctx, id : string, version : uint32_t) : optional<workflow_instance>
    +remove(ctx, id : string)
}

class ores::workflow::repository::workflow_step_mapper <<generated>> {
    +{static} map(entity) : workflow_step
    +{static} map(step) : workflow_step_entity
}

class ores::workflow::repository::workflow_step_repository <<generated>> {
    +write(ctx, v : workflow_step)
    +read_latest(ctx, id : string) : vector<workflow_step>
    +read_latest_by_workflow_id(ctx, workflow_id : string, offset : uint32_t, limit : uint32_t) : vector<workflow_step>
    +read_at_version(ctx, id : string, version : uint32_t) : optional<workflow_step>
    +remove(ctx, id : string)
}

class ores::workflow::service::fsm_state_map <<struct>> {
    +require(name : string_view) : uuid
}

class ores::workflow::service::load_fsm_states <<generated free function>> {
    +{static} load_fsm_states(ctx, machine_name : string) : fsm_state_map
}

note right of "ores::workflow::service::load_fsm_states"
Reads the states of one machine from the store dq owns.
The generated wire surface addresses a state by name alone,
and a state's name is unique only within its machine, so the
machine is resolved where its name lives. The edge down to
dq's fsm_state_repository is left undrawn, as the cross-module
edges above are.
end note

class ores::workflow::service::workflow_engine <<hand-written>> {
