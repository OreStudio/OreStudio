@startuml

title ores.compute.client Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace compute #F2F2F2 {
        namespace client #F2F2F2 {
            class package_publish_result <<struct>> {
                +package_uri : std::string
                +sha256 : std::string
            }
            note top of package_publish_result
            Storage-relative URI and server-computed SHA256 of an uploaded engine package.
            end note
            class package_publisher {
                -transfer_ : ores::storage::net::storage_transfer
                +package_publisher(http_base_url : std::string)
                +publish(app_name : std::string, version : std::string, platform_code : std::string, local_file : std::filesystem::path, ext : std::string) : package_publish_result
            }
            note top of package_publisher
            Uploads an engine package to the canonical per-triplet storage location and verifies its integrity.
            end note
            package_publisher ..> package_publish_result : produces
        }
    }
}

