@startuml

title ores.http.marketdata Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace http #F2F2F2 {
        namespace routes #F2F2F2 {
            namespace trading #F2F2F2 {
                class trade_read_routes {
                    +best_identifiers(const vector<ores::trading::domain::trade_identifier>& identifiers) : map<string, string>
                    +enriched_rows(const vector<ores::trading::domain::trade_summary>& summaries, const vector<ores::trading::domain::trade_identifier>& identifiers, const vector<ores::trading::domain::structure_identifier>& structures, const vector<ores::refdata::domain::book>& books, const vector<ores::refdata::domain::counterparty>& counterparties, const vector<ores::trading::domain::trade>& trades)
                    +structures_json(const vector<ores::trading::domain::structure_member>& members, const vector<ores::trading::domain::structure_identifier>& identifiers) : string
                    +links_json(const vector<ores::trading::domain::trade_link>& links, bool other_is_to, const map<string, string>& labels) : string
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
                class marketdata_routes {
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
            }
        }
    }
}

