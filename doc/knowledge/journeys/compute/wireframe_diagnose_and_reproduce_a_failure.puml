  {#
    Interval | Rate
    14:00 | X
    14:05 | XXXX
    14:10 | XX
    14:15 | XXXXXXXX
    14:20 | XXX
  }
  <b>FAILURES BY NODE</b>
  {#
    Node | Failures | Bar
    grid-04 | 8 | XXXXXXXX
    grid-02 | 2 | XX
    grid-05 | 1 | X
  }
  <b>FAILURES BY APP VERSION</b>
  {#
    Version | Failures | Bar
    v0.0.25 | 5 | XXXXX
    v0.0.24 | 3 | XXX
    v0.0.23 | 1 | X
  }
  --
  <b>LOAD HEATMAP BY FAILURES</b> | . none  - few  + some  X many
  {#
    Node | 14:00 | 14:05 | 14:10 | 14:15 | 14:20
    grid-01 | . | . | . | - | .
    grid-02 | . | - | . | . | .
    grid-03 | . | . | - | . | .
    grid-04 | + | X | X | + | -
    grid-05 | . | . | . | . | .
  }
  --
  <b>JOB DETAIL</b>
  {#
    Field | Value
    batch | batch_2026_07_14_a
    external ref | 6f2c19a1
    app_version_id | v0.0.25
    input_uri | s3://ore/in/6f2c19a1.zip
    config_uri | s3://ore/cfg/6f2c19a1.yaml
    server_state | failed
    outcome | client error
    error_message | wrapper: engine exited with code 1
