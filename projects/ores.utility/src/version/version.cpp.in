#include "ores.utility/version/version.hpp"

#include <filesystem>
#include <fstream>
#include <sstream>
#include <string>
#include <utility>
#include <vector>

#include "ores.platform/environment/environment.hpp"
#include "ores.platform/process/executable.hpp"

namespace ores::utility::version {
namespace {

/**
 * @brief The manifest's filename, looked for beside the running executable.
 */
constexpr const char* manifest_filename = "version.manifest";

/**
 * @brief The manifest field holding the human-readable build description.
 */
constexpr const char* build_info_key = "build_info";

using manifest_fields = std::vector<std::pair<std::string, std::string>>;

/**
 * @brief Parses a manifest of =key=value= lines.
 *
 * A line with no separator, and a line with an empty key, are skipped
 * rather than treated as errors. The manifest is a record of the build, and
 * a service must start even when that record is damaged or partial.
 */
manifest_fields parse_manifest(const std::string& text) {
    manifest_fields parsed;
    std::istringstream lines(text);
    std::string line;
    while (std::getline(lines, line)) {
        if (!line.empty() && line.back() == '\r')
            line.pop_back();
        const auto separator = line.find('=');
        if (separator == std::string::npos || separator == 0)
            continue;
        parsed.emplace_back(line.substr(0, separator), line.substr(separator + 1));
    }
    return parsed;
}

/**
 * @brief Where the manifest is looked for, in order.
 *
 * The running executable's own directory comes second, which is what lets
 * one mechanism serve a local build, a package and a deployed image: each
 * ships the manifest beside the binary, so none of them has to know the
 * working directory.
 */
std::vector<std::filesystem::path> manifest_candidates() {
    std::vector<std::filesystem::path> candidates;
    // environment::get_value rather than std::getenv: the MSVC STL deprecates
    // the latter in favour of _dupenv_s, which breaks this file on Windows
    // Clang under -Werror=deprecated-declarations.
    if (const auto from_env =
            ores::platform::environment::environment::get_value("ORES_VERSION_MANIFEST");
        from_env && !from_env->empty()) {
        candidates.emplace_back(*from_env);
    }
    const auto executable = ores::platform::process::executable_path();
    if (!executable.empty())
        candidates.push_back(executable.parent_path() / manifest_filename);
    candidates.emplace_back(std::filesystem::path("/usr/local/share/ores") / manifest_filename);
    candidates.emplace_back(std::filesystem::path("/etc/ores") / manifest_filename);
    return candidates;
}

/**
 * @brief Reads the build description from the first manifest that carries it.
 *
 * Reading is best effort by design. A missing, unreadable or partial
 * manifest leaves the version reporting the release with an unknown commit,
 * which is a better outcome than refusing to start.
 */
std::string read_build_info() {
    static const std::string info = [] {
        for (const auto& path : manifest_candidates()) {
            std::error_code ec;
            if (!std::filesystem::is_regular_file(path, ec))
                continue;
            std::ifstream in(path);
            if (!in)
                continue;
            std::ostringstream buffer;
            buffer << in.rdbuf();
            for (const auto& [key, value] : parse_manifest(buffer.str()))
                if (key == build_info_key)
                    return value;
            // A manifest that is readable but lacks the field is as good as
            // no manifest; keep looking rather than settling for it.
        }
        return std::string();
    }();
    return info;
}

}

const char* build_info() {
    static const std::string info = [] {
        std::string from_manifest = read_build_info();
        return from_manifest.empty() ? std::string("unknown") : std::move(from_manifest);
    }();
    return info.c_str();
}

const char* platform_triplet() {
    return ORES_PLATFORM_TRIPLET;
}

std::string full_version_string() {
    std::ostringstream ss;
    ss << "v" ORES_VERSION << " [" << ORES_PLATFORM_TRIPLET << "]"
       << " (" << build_info() << ")";
    return ss.str();
}

std::string format_startup_message(const std::string& service_name) {
    std::ostringstream ss;
    ss << "Starting " << service_name << " v" ORES_VERSION
       << " [" << ORES_PLATFORM_TRIPLET << "]"
       << " (" << build_info()
       << " " << ores::platform::process::executable_build_time() << ")";
    return ss.str();
}

std::string format_startup_message(const std::string& service_name,
    std::uint16_t protocol_major, std::uint16_t protocol_minor) {
    std::ostringstream ss;
    ss << "Starting " << service_name << " v" ORES_VERSION
       << " [" << ORES_PLATFORM_TRIPLET << "]"
       << " Protocol " << protocol_major << "." << protocol_minor
       << " (" << build_info()
       << " " << ores::platform::process::executable_build_time() << ")";
    return ss.str();
}

}
