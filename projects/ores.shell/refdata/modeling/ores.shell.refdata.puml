@startuml

title ores.shell.refdata Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace shell #F2F2F2 {
        namespace app #F2F2F2 {
            namespace commands #F2F2F2 {
                namespace refdata #F2F2F2 {
                    class refdata_commands {
                        {static} +register_commands(root_menu : cli::Menu&, session : nats_client&, pagination : pagination_context&)
                    }
                    class country_commands {
                        {static} +register_commands(root_menu : cli::Menu&, session : nats_client&, pagination : pagination_context&)
                    }
                    class currency_commands {
                        {static} +register_commands(root_menu : cli::Menu&, session : nats_client&, pagination : pagination_context&)
                    }
                    class party_commands {
                        {static} +register_commands(root_menu : cli::Menu&, session : nats_client&, pagination : pagination_context&)
                    }
                }
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---

refdata_commands ..> country_commands : registers
refdata_commands ..> currency_commands : registers
refdata_commands ..> party_commands : registers

ores.shell.api ..> ores.shell.refdata : pagination_context
ores.refdata.api ..> ores.shell.refdata : domain, messaging

' Local Variables:
' compile-command: "java -Djava.awt.headless=true -DPLANTUML_SECURITY_PROFILE=UNSECURE -DPLANTUML_LIMIT_SIZE=65535 -jar /usr/share/plantuml/plantuml.jar ores.shell.refdata.puml"
' End:
@enduml
