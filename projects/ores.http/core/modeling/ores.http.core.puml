                }
                class variability_routes {
                    -ctx_ : database::context
                    -system_settings_ : shared_ptr<variability::service::system_settings_service>
                    -sessions_ : shared_ptr<iam::service::auth_session_service>
                    +variability_routes(database::context ctx, shared_ptr<variability::service::system_settings_service> system_settings, shared_ptr<iam::service::auth_session_service> sessions)
                    +register_routes(shared_ptr<http::net::router> router, shared_ptr<http::openapi::endpoint_registry> registry) : void
