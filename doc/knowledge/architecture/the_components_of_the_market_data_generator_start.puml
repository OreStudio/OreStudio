@startuml
autonumber
participant "screen or shell" as user
participant "feed_config_handler" as handler
participant "feed_kind_registry" as registry
participant "feed_factory" as factory
participant "run_market" as market
participant "market_board" as values
participant "tick_scheduler" as loop
participant "the feed" as feed

user -> handler : start the feed of a config row
handler -> registry : the row, with its container
registry -> registry : read the config, its expiries and its contributors
registry -> factory : make(kind, build_input, context)
factory -> market : loop(), values()
factory -> feed : construct(source, config, market)
feed -> values : member_of(kind, code)
values --> feed : member id, resolved once
feed -> loop : add(series_spec, body)
note right of loop : the body captures the feed.\nThe loop applies it at its own now.
loop --> factory : series id
factory --> registry : the feed, started or refused
registry --> handler : started, or the reason it cannot be
handler --> user : the reply
@enduml
