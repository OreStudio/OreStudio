@startuml
title The audit chain of a feed's daily variance

rectangle "Run of a feed\n(start record)" as run
rectangle "FX spot feed\n(config version)" as feed
rectangle "Variance calibration\n(shape, evidence, state, reason)" as cal
rectangle "Variance calibration input\n(item, provider, policy and version, window)" as input
rectangle "Input points\n(fixing as stored, return, used or why not)" as points
rectangle "Fixings\n(public sources)" as fixings
rectangle "Calibration policy\n(variance window, provider order)" as policy

run --> cal : names id and version
feed --> cal : names the approved one
cal --> input : fitted from
input --> points : holds
points --> fixings : read from
input --> policy : read under
@enduml
