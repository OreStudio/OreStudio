@startuml
title Figure 1. The target lifecycle: a report references the published curve
skinparam backgroundColor #FFFFFF
skinparam defaultFontName sans-serif
skinparam componentStyle rectangle

actor "Public source\n(ECB, H.10, Treasury,\nNY Fed, BoE via Frankfurter)" as src
component "Official adapter" as official
component "Synthetic generator\n(initial value, volatility)" as gen
component "Subscription, route,\ndemand" as sub
component "Curve blueprint\n(pillars name their series)" as bp
component "Approval\n(maker, checker)" as appr
component "Published set" as pub
component "Report run" as rep
component "ORE XML" as ore

src --> official : fixing, oresmd
official --> gen : durable fixing, oresmd
gen --> sub : synthetic ticks, oresmd
sub --> bp : quotes, oresmd
bp --> appr : candidate
appr --> pub : published set, oresmd
rep --> ore : ORE XML (ORE keys)
pub --> rep : published set, oresmd
@enduml
