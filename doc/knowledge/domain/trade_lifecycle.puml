@startuml
!pragma layout smetana

title Trade status state machine

skinparam state {
    BackgroundColor #D6E8FA
    BorderColor #4A78A8
    FontColor #1A1A1E
    AttributeFontColor #3A3A3E
    ArrowColor #4A78A8
    ArrowFontColor #1A1A1E
    StartColor #4A78A8
    EndColor #4A78A8
}
skinparam note {
    BackgroundColor #FBF3D3
    BorderColor #C9A227
    FontColor #1A1A1E
}
skinparam BackgroundColor white
skinparam DefaultFontColor #1A1A1E

state "new" as New
state "live" as Live
state "expired" as Expired
state "cancelled" as Cancelled

New : Booked; awaiting confirmation of terms
Live : Confirmed and active; in risk and P&L
Expired : Contract ceased naturally
Cancelled : Removed from the book

[*] --> New : Book
New --> Live : Confirm
New --> Cancelled : Cancel
Live --> Expired : Expire / Mature / Exercise
Live --> Cancelled : Cancel / Terminate
Expired --> [*]
Cancelled --> [*]

note right of New
  New Activity events land here.
  They require confirmation.
end note

note right of Live
  Life-Cycle Events apply here.
  They change terms without
  changing status.
end note

note bottom of Cancelled
  Confirm is the only route into Live.
  A trade that never confirms, such as an
  intra-entity transfer, a test booking or
  a hypothetical, cannot reach Live in
  this machine.
end note

@enduml
