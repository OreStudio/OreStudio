@startuml

title Access Token: the edge authenticates once, and every service verifies the token itself

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber


actor "client" as client
participant "IAM\n(the only signer)" as iam
participant "a service" as svc
participant "another service" as svc2
database "store\n(row-level security)" as db

client -> iam : log in
iam --> client : signed token (tenant, party, permissions, expiry)
svc -> iam : at startup: fetch the public key (JWKS)
client -> svc : request (Authorization: Bearer token)
svc -> svc : verify the signature and the expiry;\nbuild the request context
svc -> svc : check the permission
svc -> db : set the session tenant and party; read
db --> svc : the rows the context may see
svc -> svc2 : a further call carries a token\n(relayed, or the service's own)
svc --> client : response, or X-Error: unauthorized, forbidden, token_expired

@enduml
