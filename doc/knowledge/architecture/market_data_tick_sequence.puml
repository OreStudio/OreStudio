@startuml

title One tick, from the demand to the party's stream

hide footbox
skinparam sequenceMessageAlign left

participant "Party" as p
participant "Routing" as r
participant "Adapter\n(live or simulated)" as a
participant "Mapping" as m
participant "Quality" as q
database "Store" as s
participant "Fan-out" as f
participant "Metering" as mt

p -> r : subscribe to provider (rights)
r -> r : check entitlement, resolve source
r -> mt : subscription interval opens
r -> a : demand(set of external ids)\nrequest/reply
a --> r : accepted, rejected ids
r -> mt : demand interval opens

loop every vendor update
    a -> m : tick(external id, field, value, vendor time)\nmarketdata.v1.ingress.<adapter>.>
    m -> m : (provider, scheme, id, field) to item
    m -> q : item, value
    q -> q : range check, staleness, conflation
    q -> s : write (item, provider, party)\nfor each party routed to the source
    s -> f : stored
    f -> p : market_tick on the party stream
    f -> mt : delivery counted per party
end

@enduml
