@startuml

title ores.workspace.core Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace workspace #F2F2F2 {
        namespace messaging #F2F2F2 {
            class registrar <<free functions>> {
                {static} +register_handlers(nats, ctx, verifier) : subscriptions
            }
            class workspace_handler {
                -nats_ : ores::nats::service::client&
                -ctx_ : ores::database::context
                -verifier_ : optional<ores::security::jwt::jwt_authenticator>
                +list_workspaces(msg)
                +get_workspace(msg)
                +get_many_workspaces(msg)
                +put_workspace(msg)
                +put_many_workspaces(msg)
                +delete_workspace(msg)
                +delete_many_workspaces(msg)
                +list_workspace_versions(msg)
                +get_workspace_version(msg)
            }
            class workspace_history_provider_registrar <<free functions>> {
                +register_workspace_history_provider(registry)
            }
            class workspace_operations_handler {
                -nats_ : ores::nats::service::client&
                -ctx_ : ores::database::context
                -verifier_ : optional<ores::security::jwt::jwt_authenticator>
                +resolve(msg)
                +set_trade_scope(msg)
                +clear_trade_scope(msg)
            }
            class workspace_registrar <<free functions>> {
                +register_workspace_handlers(nats, ctx, verifier) : subscriptions
            }
        }
        namespace presentation #F2F2F2 {
            class workspace_history_field_mapper <<free function>> {
                +render_workspace_fields(v) : vector<diff::domain::field_value>
            }
        }
        namespace repository #F2F2F2 {
            class workspace_entity <<struct>> {
                +schema : constexpr static const char*
                +tablename : constexpr static const char*
                +id : sqlgen::PrimaryKey<string>
                +tenant_id : string
                +version : int
                +name : string
                +party_id : string
                +owner_id : string
                +description : string
                +source_path : optional<string>
                +parent_workspace_id : optional<string>
                +scope_portfolio_id : optional<string>
                +status_code : string
                +modified_by : string
                +performed_by : string
                +change_reason_code : string
                +change_commentary : string
                +valid_from : db_timestamp
                +valid_to : db_timestamp
            }
            class workspace_mapper {
                {static} +map(entity) : domain::workspace
                {static} +map(v) : workspace_entity
                {static} +map(entities) : vector<domain::workspace>
                {static} +map(vs) : vector<workspace_entity>
            }
            class workspace_repository {
                +sql() : string
                +write(ctx, v)
                +write(ctx, vs)
                +write(ctx, v, claim)
                +write(ctx, vs, claims)
                +read_latest(ctx) : vector<domain::workspace>
                +read_latest(ctx, id)
                +read_latest(ctx, ids)
                +read_all(ctx, id)
                +read_at_version(ctx, id, version) : optional<domain::workspace>
                +read_latest(ctx, offset, limit)
                +get_total_workspace_count(ctx) : uint32_t
                +remove(ctx, id)
                +remove(ctx, id, version) : remove_status
                +remove(ctx, ids)
                +get_hierarchy(ctx, root_id, from_root) : vector<utility::domain::hierarchy_flat_row>
                +resolution_order(ctx, workspace_id) : vector<string>
                +set_trade_scope(ctx, workspace_id, trade_ids)
                +clear_trade_scope(ctx, workspace_id)
                +remove_status : enum class
                -replace_claim(ctx, v) : utility::domain::precondition
                -apply_claim(ctx, v, claim) : domain::workspace
            }
        }
        namespace service #F2F2F2 {
            class workspace_service {
                -ctx_ : context
                -repo_ : repository::workspace_repository
                +list_workspaces(request) : messaging::list_workspaces_response
                +get_workspace(request) : messaging::get_workspace_response
                +get_many_workspaces(request) : messaging::get_many_workspaces_response
                +put_workspace(request) : messaging::put_workspace_response
                +put_many_workspaces(request) : messaging::put_many_workspaces_response
                +delete_workspace(request) : messaging::delete_workspace_response
                +delete_many_workspaces(request) : messaging::delete_many_workspaces_response
                +list_workspace_versions(request) : messaging::list_workspace_versions_response
                +get_workspace_version(request) : messaging::get_workspace_version_response
                +list_workspaces(offset, limit) : vector<domain::workspace>
                +count_workspaces() : uint32_t
                +get_workspace_at_version(id, version) : optional<domain::workspace>
                +get_workspace(id) : optional<domain::workspace>
                +get_workspaces(ids) : vector<domain::workspace>
                +save_workspace(workspace)
                +save_workspaces(workspaces)
                +delete_workspace(id)
                +delete_workspaces(ids)
                +get_workspace_history(id) : vector<domain::workspace>
                +get_hierarchy(root_id, from_root) : vector<utility::domain::hierarchy_node>
                -prepare_change(change, intent, out) : utility::domain::result
            }
        }
    }
}

