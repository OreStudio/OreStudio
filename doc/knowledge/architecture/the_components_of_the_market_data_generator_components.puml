@startuml
skinparam componentStyle rectangle
hide empty description

package "Control plane" {
    [feed_config_handler] as handlers
    [feed_kind_registry] as registry
    [feed_factory] as factory
}

package "Generators" {
    [fx_spot_feed] as spot
    [ir_curve_feed] as curve
    [fx_vol_surface_feed] as surface
}

package "The run's market" {
    [run_market] as market
    [tick_scheduler] as loop
    [latent_market] as noise
    [market_board] as values
}

package "Processes and engines" {
    [i_stochastic_process] as process
    [i_yield_curve_process] as ycurve
    [fx_vol_surface_generator] as engine
}

cloud "NATS" {
    [tick subjects] as ticks
    [tick.&lt;source&gt; display] as display
}

handlers --> registry : kinds and build inputs
registry --> factory : kind, input, context
factory --> spot
factory --> curve
factory --> surface
spot --> market : loop(), values()
curve --> market : loop(), values()
surface --> market : loop(), values()
market *-- loop
market *-- noise
market *-- values
loop --> noise : driver hook, one call a tick
spot --> process
curve --> ycurve
surface --> engine
spot --> ticks
curve --> ticks
surface --> ticks
surface --> display
ticks --> [marketdata ingest]
@enduml
