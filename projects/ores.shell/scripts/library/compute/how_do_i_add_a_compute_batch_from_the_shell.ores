# How do I add a compute batch from the shell?
# Create a compute batch with an external reference from the shell; the job count belongs to dispatch, not to the batch.
#
# GENERATED from doc/recipes/shell/compute/how_do_i_add_a_compute_batch_from_the_shell.org — do not edit by hand.
# Regenerate with: ./compass.sh build --direct tangle_shell_scripts
#
connect $ORES_NATS_URL
login super_admin@localhost Secure-Password-123
batches add $BATCH_REF open system.new_record "compute batch"
logout
