@startuml

title ores.marketdata.official Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace marketdata #F2F2F2 {
        namespace official #F2F2F2 {
            namespace domain #F2F2F2 {
                class published_fixing <<struct>> {
                    +date : year_month_day
                    +external_id : string
                    +value : string
                }

                class hosted_source <<struct>> {
                    +source_name : string
                    +provider_code : string
                    +adapter_code : string
                    +key : string
                }

                abstract class fetcher {
                    +adapter_code() : string_view
                    +id_scheme() : string_view
                    +field() : string_view
                    +universe(string_view key) : expected<vector<string>, string>
                    +fixings(string_view key, year_month_day from, year_month_day to) : expected<vector<published_fixing>, string>
                }

                class published_rate <<struct>> {
                    +date : year_month_day
                    +base : string
                    +quote : string
                    +rate : string
                }

                class frankfurter_fetcher {
                    +provider(string_view key) : expected<provider_universe, string>
                    +rates(string_view key, string_view pivot, year_month_day from, year_month_day to) : expected<vector<published_rate>, string>
                    +misbased() : uint64_t
                }

                class nyfed_fetcher {
                    +universe(string_view key) : expected<vector<string>, string>
                    +fixings(string_view key, year_month_day from, year_month_day to) : expected<vector<published_fixing>, string>
                }

                class ecb_fetcher {
                    +universe(string_view key) : expected<vector<string>, string>
                    +fixings(string_view key, year_month_day from, year_month_day to) : expected<vector<published_fixing>, string>
                }

                class published_text <<functions>> {
                    +text_of(double) : string
                    +date_of(string_view) : expected<year_month_day, string>
                    +decimal_of_percent(string_view) : expected<string, string>
                    +read_body(transport&, const string&) : expected<string, string>
                }

                class source_feed {
                    -universe_ : set<string>
                    -demanded_ : set<string>
                    -last_sent_ : map<string, year_month_day>
                    +load_universe() : expected<void, string>
                    +announcement() : adapter_announce_request
                    +answer(const adapter_demand_request&) : adapter_demand_response
                    +demand(const adapter_demand_request&) : adapter_demand_response
                    +refresh(year_month_day today, publish_fn) : expected<size_t, string>
                }

                fetcher <|-- frankfurter_fetcher
                fetcher <|-- nyfed_fetcher
                frankfurter_fetcher ..> published_text
                nyfed_fetcher ..> published_text
                fetcher <|-- ecb_fetcher
                ecb_fetcher ..> published_text
                source_feed --> hosted_source
                source_feed --> fetcher
                fetcher ..> published_fixing
                frankfurter_fetcher ..> published_rate
            }

            namespace app #F2F2F2 {
                class official_adapter {
                    +subscribe() : vector<subscription>
                    +start() : void
                    +stop() : void
                }

                class application {
                    +run(io_context&, const options&) : awaitable<void>
                }

                application --> official_adapter
                official_adapter "1" *-- "many" ores::marketdata::official::domain::source_feed
                official_adapter "1" o-- "many" ores::marketdata::official::domain::fetcher
            }
        }
    }
}


@enduml
