@startuml

title Two engine builds for one book, and the open question of the headline

skinparam componentStyle rectangle

package "A book's trades" {
    component "Options expiring today\n(European, digital, barrier,\ntouch, American)" as today
    component "Every other trade" as rest
}

package "ORE engine packages" {
    component "Intraday build\nQL_HIGH_RESOLUTION_DATE,\nasof with a time of day,\nexpiry cut on the trade" as intraday
    component "Regular build\nday resolution" as regular
}

database "Market data snapshot\nstamped with the valuation time;\nvolatility pillars at today's cuts" as snapshot

component "Same-day reports\nnot started" as sameday
component "Headline position\nfor the book" as headline

today --> intraday
rest --> regular
snapshot --> intraday
snapshot --> regular : ?
intraday --> sameday
regular --> headline
sameday ..> headline : stitched together: how?

note right of headline
    open: one book total from two runs
    at two resolutions; the regular run
    sees today's expiries alive all day
end note

@enduml
