    {
      "id": "loop-discovery-calculation",
      "group": "tool-chaining",
      "intent": "compute using discovered trade economics",
      "profiles": [
        "replay",
        "model"
      ],
      "turns": [
        {
          "message": "Find the first two trades and compute their total sold amount, keeping currencies separate.",
          "replay": [
            {
              "tool": "find_trades",
              "arguments": {
                "limit": 2
              }
            },
            {
              "tool": "read_trade",
              "arguments": {
                "tradeId": "11111111-1111-4111-8111-000000000005"
              }
            },
            {
              "tool": "read_trade",
              "arguments": {
                "tradeId": "11111111-1111-4111-8111-000000000006"
              }
            },
            {
              "tool": "calculate",
              "arguments": {
                "operation": "sum",
                "values": [
                  "100",
                  "200"
                ]
              }
            },
            {
              "content": "The two trades sold a total of 300 GBP."
            }
          ],
          "expect": {
            "tool": "calculate",
            "evidenceOrder": [
              "find_trades",
              "read_trade",
              "read_trade",
              "calculate"
            ],
            "checks": [
              {
                "path": "value",
                "equals": "300"
              }
            ],
            "contains": [
              "300",
              "GBP"
            ]
          }
        }
      ]
    }
  ]
