@startuml
!pragma layout smetana

title Trade Modeling

hide circle
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #D6E8FA
    BorderColor #2C5C8A
}
skinparam object {
    BackgroundColor #EDF6EC
    BorderColor #4C7A44
}

package "The data model" {
    class "product type" as pt {
        code : TradeType  <<key>>
        asset class
    }

    class security {
        id  <<key>>
        product type
        terms fixed at issue
    }

    class trade {
        trade id  <<key>>
        product type
        security [optional]
        envelope
    }

    class "instrument\n(the economics)" as instr #E8F0D8 {
        trade id  <<key>>
        notional, direction
        schedule, strike, rate
    }

    pt "1" -- "0..*" security : classifies
    security "1" -- "0..*" trade : is dealt by
    pt "1" -- "0..*" trade : classifies
    trade "1" -- "1" instr : keyed by trade id
}

note bottom of instr #E8F0D8
  Modelled per product type, as
  bond_instrument and its siblings.
  It holds no identity of its own:
  its terms differ per deal, so the
  trade id keys them.
end note

package "Exemplar: a bond, which has a security" {
    object "Bond : product type" as ex_bond_pt
    object "UKT 4.25% 2032 : security" as ex_bond_sec
    object "TRD-00871 : trade" as ex_bond_trd
    object "TRD-00871 : instrument" as ex_bond_instr

    ex_bond_pt -- ex_bond_sec
    ex_bond_sec -- ex_bond_trd
    ex_bond_trd -- ex_bond_instr
}

package "Exemplar: a swaption, which has none" {
    object "Swaption : product type" as ex_swp_pt
    object "TRD-00912 : trade" as ex_swp_trd
    object "TRD-00912 : instrument" as ex_swp_instr

    ex_swp_pt -- ex_swp_trd
    ex_swp_trd -- ex_swp_instr
}

note bottom of ex_swp_instr
  No security exists to name, so the
  trade carries every economic term.
end note

@enduml
