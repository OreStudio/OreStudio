{
  "name": "@ores/wire-protocol",
  "version": "0.0.1",
  "private": true,
  "description": "ORE Studio NATS wire protocol for TypeScript. Encoding, subjects, domain models and the typed client.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "nats": "2.29.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
