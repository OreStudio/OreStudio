@startuml

title One value: as ORE wrote it, as the row holds it, as the set judges it

actor "document" as caller
participant "projection\nread" as codec
participant "projection\nmap" as map
participant "entity mapper" as mapper
participant "value set\nore_renderings.json" as set
database "ores_refdata_*_configs_tbl" as db
participant "validate_curve_values_fn" as guard

caller -> codec : curveconfig.xml, MF
codec --> map : record, MF kept
map --> mapper : rows, MF
mapper -> db : insert MF
db -> guard : before insert
guard -> set : canonical_value_fn(set, MF)
set --> guard : ModifiedFollowing
guard --> db : store ModifiedFollowing, or raise naming the set

legend bottom
A conventions document's codec converts on read, from the tables
generated from the same file, so its mapper receives Following
instead of F.
end legend

@enduml
