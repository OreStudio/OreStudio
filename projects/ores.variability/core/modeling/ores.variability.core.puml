                +complete_party_onboarding(ores::nats::message msg) : void
            }
            class registrar {
                +register_handlers(ores::nats::service::client& nats, ores::database::context ctx, optional<ores::security::jwt::jwt_authenticator> verifier) : vector<ores::nats::service::subscription>
            }
            class system_setting_handler {
                -nats_ : ores::nats::service::client&
                -ctx_ : ores::database::context
                -verifier_ : optional<ores::security::jwt::jwt_authenticator>
                +list_system_settings(ores::nats::message msg) : void
                +get_system_setting(ores::nats::message msg) : void
                +get_many_system_settings(ores::nats::message msg) : void
                +put_system_setting(ores::nats::message msg) : void
                +put_many_system_settings(ores::nats::message msg) : void
                +delete_system_setting(ores::nats::message msg) : void
                +delete_many_system_settings(ores::nats::message msg) : void
                +list_system_setting_versions(ores::nats::message msg) : void
