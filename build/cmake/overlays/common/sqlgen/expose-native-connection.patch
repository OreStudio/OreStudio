diff --git a/include/sqlgen/postgres/Connection.hpp b/include/sqlgen/postgres/Connection.hpp
--- a/include/sqlgen/postgres/Connection.hpp
+++ b/include/sqlgen/postgres/Connection.hpp
@@ -61,6 +61,10 @@
 
   ~Connection() = default;
 
+  /// The libpq connection, for code that must run on the same server
+  /// session, such as inside a transaction this connection holds open.
+  PGconn* native_handle() const noexcept { return conn_.ptr(); }
+
   Result<Nothing> begin_transaction() noexcept;
 
   Result<Nothing> commit() noexcept;
diff --git a/include/sqlgen/Session.hpp b/include/sqlgen/Session.hpp
--- a/include/sqlgen/Session.hpp
+++ b/include/sqlgen/Session.hpp
@@ -38,6 +38,10 @@
     }
   }
 
+  /// The connection this session holds, for code that must run on the
+  /// same server session.
+  const ConnPtr& conn() const noexcept { return conn_; }
+
   Result<Nothing> begin_transaction() { return conn_->begin_transaction(); }
 
   Result<Nothing> commit() { return conn_->commit(); }
