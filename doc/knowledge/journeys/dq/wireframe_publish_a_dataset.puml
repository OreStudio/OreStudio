@startuml

salt
{
  <b>PUBLISH A DATASET</b>  { refdata.conventions | Publish }
  --
  {
    {
      <b>refdata.conventions</b>
      ORE Instrument Conventions
      --
      <b>Destination, read from the artefact type</b>
      staging    ores_dq_conventions_artefact_tbl
      target     ores_refdata_conventions_tbl
      subject    refdata.v1.ops.publish_conventions_from_dq
      --
      <b>Counts</b>
      staged 10,991    published 10,991
      <i>The second count is the provenance rows, which no subject offers.</i>
    } | {
      <b>Mode</b>
      ( ) Upsert   ( ) Insert only   ( ) Replace all
      --
      <b>Preview</b>
      {#
        Insert | Update | Skip
        0 | 0 | 10991
      }
      <i>A dataset whose rows agree reports every row skipped.</i>
      --
      <b>Receipt</b>
      workflow instance 7f3c-4a91-9d20
      inserted 0 · updated 0 · skipped 10991 · deleted 0
      --
      <b>What the verb cannot check</b>
      The dataset names no level, so the target tenant is not the verb's to decide.
    }
  }
  --
  { Publish | <i>No history row: nothing writes the run log.</i> }
}

@enduml
