    {
      "id": "loop-discovery-details",
      "group": "tool-chaining",
      "intent": "discovery-details",
      "profiles": [
        "replay",
        "model"
      ],
      "turns": [
        {
          "message": "Find the first trade and show its details.",
          "replay": [
