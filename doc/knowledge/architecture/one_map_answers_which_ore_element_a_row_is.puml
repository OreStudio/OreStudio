@startuml

title The eight tables that touch an ORE document, grouped by the question each answers

hide circle
skinparam linetype ortho
top to bottom direction

package "A. Which parameter is this, and where is it in the document" as A {
    entity "ores_reporting_ore_parameters_tbl\n(the per-tenant contract)" as params <<temporal>> #C6F0D8 {
        * code : text <<PK>>
        --
        * scope : text
        * subtype : text
        * name : text
        * schema_name : text
        * xpath : text
        * ore_parameter_value_domain_code : text
    }
    entity "ores_dq_ore_parameters_artefact_tbl\n(staging)" as artefact #ECECEC {
        * dataset_id : uuid
        * id : uuid
        --
        the same columns, from the guide
    }
}

package "B. Which leaf is this row, and which set governs it" as B {
    entity "ores_reporting_ore_parameter_vocabularies_tbl\n(the element map)" as vocab <<temporal>> #C6F0D8 {
        * code <<PK>>\n(schema|address)
        --
        * schema_name
        * xpath
        * element_name
        * value_set_code
        * source
        * reason
    }
    entity "ores_reporting_ore_element_map_columns_tbl" as child <<temporal>> #C6F0D8 {
        * code <<PK>>
        --
        * element_map_code
        * entity_name
        * table_name
        * column_name
    }
    entity "ores_refdata_curve_configuration_columns_tbl" as curvec <<temporal>> {
        * code <<PK>>
        --
        * entity_name
        * column_name
        * xpath
    }
    entity "ores_refdata_convention_kind_terms_tbl" as terms <<temporal>> {
        * code <<PK>>
        --
        * kind_code
        * column_name
        * xpath
    }
}

package "C. What a screen offers" as C {
    entity "ores_reporting_engine_settings_group_settings_tbl" as groups <<temporal>> {
        * code <<PK>>
        --
        * group_code
        * column_name
        * ore_name
        * changes_numbers
    }
    entity "ores_analytics_pricing_pair_settings_tbl" as pairs <<temporal>> {
        * code <<PK>>
        --
        * pricing_engine_type_code
        * model
        * engine
        * scope
        * name
        * usual_value
    }
}

package "D. Where the rule is" as D {
    entity "ores_reporting_ore_parameter_value_sets_tbl" as sets <<temporal>> {
        * code : text <<PK>>
        --
        * source_kind : text
        * catalogue_code : text
        * pattern : text
    }
    entity "ores_reporting_ore_parameter_setting_value_sets_tbl" as links <<temporal>> {
        * code : text <<PK>>\n(Scope:Name)
        --
        * scope : text
        * name : text
        * value_set_code : text
    }
}

artefact ..> params : published into, by dataset
child }o--|| vocab : "element_map_code"
vocab }o--|| sets : "value_set_code"
links }o--|| sets : "value_set_code"
curvec ..> child : seeds it
terms ..> child : seeds it
params ||--o{ links : "scope : name"

note bottom of B
  One leaf, one row. The guards read the child columns
  and the map, B -> D in two joins, and the map states
  the set its leaf takes rather than resolving it through
  the contract. The two column maps below seed the child
  and have no runtime reader.
end note

note bottom of A
  Documentation for the screens: what a parameter is
  called, what it means and where it sits. It is no
  longer a step between a column and its rule.
end note

note bottom of C
  Screen inventories, not document maps: a screen reads them to
  draw a control, and no guard consults either.
end note

@enduml
