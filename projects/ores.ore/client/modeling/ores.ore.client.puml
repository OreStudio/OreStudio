@startuml

title ores.ore.client Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace ore #F2F2F2 {
        namespace service #F2F2F2 {
            namespace cache #F2F2F2 {
                class ore_parameter_cache {
                    +load(tenant_id) : void
                    +lookup(tenant_id, id) : optional<ore_parameter>
                    +analytics_parameters(tenant_id) : analytic_parameters
                    -nats_ : ores::nats::service::client&
                    -cache_ : cache_t
                }
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---
note as N_ORE_CLIENT_CONSUMERS
  The reporting service reads the analytic parameters to write a run's
  document. The cache pages ores.ore's list of parameters at load, and the
  registrar subscribes its changed events, so no consumer reads ores.ore's
  tables.
end note
ores::ore::service::cache::ore_parameter_cache .. N_ORE_CLIENT_CONSUMERS


