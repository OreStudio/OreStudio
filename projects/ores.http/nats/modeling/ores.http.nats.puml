@startuml

title ores.http.nats Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace http #F2F2F2 {
        namespace forwarding #F2F2F2 {
            class forwarding << (F,#B4D7F7) functions >> {
                +forward<Request>(const http_request& req, nats_client& session, const Request& msg) : Request::response_type
                +respond<Request>(const http_request& req, nats_client& session, const Request& msg) : http_response
                +refusal_for(string_view code) : record_routes::refusal
                +refuse_refused(const request_refused_error& e) : void
                +refuse_lapsed(const session_expired_error& e) : void
                +refuse_undecodable(string_view subject, const string& detail) : void
                +unanswered(string_view subject, const exception& e) : http_response
            }
            note top of forwarding
                One HTTP request sent to a service over NATS as the caller.
                The NATS half is ores.nats's request_and_decode; this part
                maps each failure to the HTTP refusal the browser reads.
            end note
        }
    }
}

@enduml
