@startuml
object "board : market_board" as board
object "curve:USD" as usd
object "curve:EUR" as eur
object "spot:EUR/USD" as spot

board *-- usd : member 0
board *-- eur : member 1
board *-- spot : member 2

usd : kind = curve
usd : spot_date = 2026-11-16
usd : published_at = 10:31:04
usd : points[3] = {{2026-11-16, 1.0}, {2027-02-16, 0.9882}, {2027-11-16, 0.9694}}

eur : kind = curve
eur : spot_date = 2026-11-16
eur : published_at = 10:31:07
eur : points[3] = {{2026-11-16, 1.0}, {2027-02-16, 0.9931}, {2027-11-16, 0.9821}}

spot : kind = spot
spot : published_at = 10:31:09
spot : spot = 1.0842

object "surface : fx_vol_surface_feed" as surface
surface : holds three member ids, resolved when it was built
surface ..> eur : reads by id
surface ..> usd : reads by id
surface ..> spot : reads by id
note right of surface
  Each tick it builds one market per expiry:
  spot, P_quote from curve:EUR, P_base from curve:USD,
  resolved at the expiry's own date.
end note
@enduml
