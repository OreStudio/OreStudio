@startuml

title Bundle layout: the artefacts and the objects each participant reads

package "object storage" as storage {
  folder "bundles/{bundle_id}/" {
    artifact "manifest.msgpack\n(generated operation type)" as manifest
    artifact "bundle.zip.zst\n(zstd entries, central directory)" as archive
    folder "archive entries" {
      artifact "refdata/currency\n(part: msgpack rows)" as rpart
      artifact "refdata/calendar\n(part: msgpack rows)" as cpart
      artifact "trading/trade\n(part: msgpack rows)" as tpart
    }
  }
}

component "producer" as producer
component "coordinator" as coordinator
component "refdata owner" as refdata
component "trading owner" as trading
component "ORE XML converter" as converter

producer --> manifest : writes
producer --> archive : writes, by byte copy
coordinator --> manifest : reads only
refdata --> rpart : reads its entry
refdata --> cpart : reads its entry
trading --> tpart : reads its entry
converter --> manifest : reads
converter --> archive : reads every entry
note bottom of storage
  The archive embeds the same manifest bytes.
  A component reads the entries it is allowed
  to read, and no other.
end note

@enduml
