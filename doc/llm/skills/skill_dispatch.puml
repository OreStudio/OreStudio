@startuml

title compass-act — a target chooses its verbs

skinparam rectangle {
    BackgroundColor #2A2A2E
    BorderColor #58A6FF
    FontColor #E3E3E6
}
skinparam note {
    BackgroundColor #1A1A1E
    BorderColor #58A6FF
    FontColor #E3E3E6
}
skinparam ArrowColor #8AB4F8
skinparam ArrowFontColor #E3E3E6
skinparam BackgroundColor transparent
skinparam DefaultFontColor #E3E3E6
skinparam TitleFontColor #E3E3E6
skinparam TitleFontSize 16
skinparam ArrowFontColor #C9D1D9
skinparam ArrowFontSize 12
skinparam activity {
    BackgroundColor #2A2A2E
    BorderColor #58A6FF
    FontColor #E3E3E6
    DiamondBackgroundColor #1A1A1E
    DiamondBorderColor #58A6FF
    DiamondFontColor #E3E3E6
}

start
:A target;
note right
  A UUID, a PR number,
  a branch, a component,
  a service, a failing test.
end note
if (Does it carry #+type:?) then (yes)
  :Read the type
  from frontmatter;
else (no)
  :Ask compass
  for the target kind;
endif
:Look up the verbs
registered for that type;
note right
  Generated from the catalogue.
  A new action appears here
  without anyone editing a table.
end note
:Filter by the session's level;
if (Exactly one verb applies?) then (yes)
  :Run it;
else (no)
  :Present the verbs
  with a recommendation;
  :Run the chosen action;
endif
stop

@enduml
