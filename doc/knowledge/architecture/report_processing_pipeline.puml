@startuml

title Report processing: one run end to end

actor Operator
participant "ores.scheduler" as sched
participant "ores.reporting" as rep
participant "ores.trading" as trade
participant "ores.marketdata" as mkt
participant "ores.ore\n(mappers)" as ore
database PostgreSQL as db
participant "workflow engine\n(ores.workflow)" as wf
participant "ores.compute" as comp
participant "NATS\nJetStream" as js
participant "worker node" as node
participant "ORE engine" as engine
participant "ores.storage" as store

== Seeded once ==
Operator -> store : PUT the engine package
Operator -> db : report type, definition and its run configuration,\nrisk report config, book scope, compute app version, scheduler job

== A schedule fires ==
sched -> db : job instance (starting)
sched -> rep : reporting.v1.ops.trigger_report_instance\n{definition, tenant, job instance}
rep -> db : report instance (pending), read the run configuration
rep -> wf : workflow.v1.start {type, run configuration}
rep --> sched : outcome
sched -> db : job instance succeeded

== The workflow runs the phases ==
wf -> wf : build the phase list from the run configuration
note right of wf : rebuilt on every dispatch,\nso it must be a pure function

group pre-processing
    wf -> rep : reporting.v1.ops.preprocess
    rep -> trade : trading.v1.ops.scope-read {scope, as-of}
    trade --> rep : trades
    rep -> mkt : marketdata.v1.ops.resolve {trades}
    mkt --> rep : curves, fixings, quotes
    rep -> ore : map to the engine's documents (in-process)
    rep -> store : HEAD reporting/inputs/{digest}.tar.gz
    alt the artifact exists
        store --> rep : hit
    else
        rep -> store : PUT reporting/inputs/{digest}.tar.gz\n(Input/ore.xml and the files it names)
    end
    rep -> wf : workflow.v1.events.step-completed {input location, digest}
end

group submission and execution
    wf -> comp : compute.v1.report.submit\n{instance, tenant, correlation, input locations}
    comp -> db : batch, workunits, results
    comp -> js : compute.v1.work.assignments.{tenant}.{platform}\n{result, workunit, package and digest, input, output}
    comp -> wf : workflow.v1.events.step-completed {batch}
    js -> node : deliver assignment
    node -> store : GET the package, GET the input
    node -> engine : spawn (Input/ore.xml)
    engine --> node : Output/
    node -> store : PUT compute/output/{result}.tar.gz
    node -> comp : compute.v1.results.submit {result, host, output, outcome}
    comp -> db : result done, workunit canonical, batch closed
end

group retrieval
    wf -> rep : reporting.v1.ops.retrieve-results
    rep -> comp : compute.v1.results.list (by instance)
    comp --> rep : result and output location
    rep -> db : record the output location
    rep -> wf : workflow.v1.events.step-completed {output location}
end

group post-processing
    wf -> rep : reporting.v1.ops.postprocess
    rep -> store : GET compute/output/{result}.tar.gz
    store --> rep : the output archive
    rep -> db : bulk load the result files
    rep -> wf : workflow.v1.events.step-completed {rows loaded}
end

wf -> rep : reporting.v1.ops.finalise
rep -> db : instance completed
rep -> wf : workflow.v1.events.step-completed

Operator -> rep : report_instances get\n(state, output location, results, substitutions)

@enduml
