@startuml

salt
{
  <b>NEW SERVICE ACCOUNT</b>
  --
  {#
    Identity | Value
    Username | feed_loader
    Account type | service
    Email | feed_loader@example.com
    Full name | none, not a person
    Photo | none
    Job title | none
    Reporting line | none
  }
  --
  {#
    Service credential | Value
    Credential | set by the administrator
    Interactive sign-in | no
    Sign-in subject | iam.v1.auth.service-login
  }
  --
  {#
    Parties in scope | Selected
    Acme Bank | yes
    Acme Capital | no
  }
  --
  {#
    Roles | Assigned
    Ingest | yes
  }
  --
  [ Create account ] | [ Cancel ]
}

@enduml
