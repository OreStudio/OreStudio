@startuml

title Token Relay: a service forwards its caller's token

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber


actor "caller" as caller
participant "service A" as a
participant "service B" as b
database "B's store\n(row-level security)" as db

caller -> a : request (Authorization: the caller's token)
a -> a : verify the token; act as the caller
a -> b : request\n(Authorization: A's own token;\nX-Delegated-Authorization: the caller's token)
b -> b : make_request_context:\nthe delegated identity wins
b -> db : set the caller's tenant and party; read
db --> b : the caller's rows
b --> a : response
a --> caller : response

@enduml
