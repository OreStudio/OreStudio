@startuml

title An agent's booking goes live unauthorised, and its authorisation waits for the person and then Operations

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Agent" as agent
participant "ores.http" as http
participant "ores.trading" as trading
participant "ores.inbox" as inbox
actor "Person" as person
actor "Operations\nauthoriser" as ops

agent -> http : call_operation(book_trade, terms)
http -> trading : book, token with act = agent
trading -> trading : trade live and unauthorised, recording the agent
trading -> inbox : raise operational authorisation:\npart 1 = the agent's person,\npart 2 = Operations
inbox --> trading : request id
trading --> http : trade id, authorisation request id
http --> agent : booked, waiting for authorisation

person -> inbox : confirm the booking (part 1)
ops -> inbox : authorise (part 2, never the agent's person)
inbox -> trading : mark the trade authorised

@enduml
