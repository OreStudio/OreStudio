@startuml

title ores.marketdata Component

set namespaceSeparator ::

package "ores.marketdata" #F2F2F2 {
    component "ores.marketdata.api" as api
    component "ores.marketdata.client" as client
    component "ores.marketdata.core" as core
    component "ores.marketdata.service" as service
}

package "ores.shell.marketdata" #F2F2F2 {
    component "shell marketdata command units" as shell_marketdata
}

component "ores.platform" as platform
component "ores.utility" as utility
component "ores.nats" as nats
component "ores.database" as database
component "ores.eventing" as eventing
component "ores.service" as service_lib
component "ores.security" as security
component "ores.telemetry" as telemetry
component "ores.iam" as iam
component "ores.refdata" as refdata
component "ores.ore" as ore
component "ores.dq" as dq
component "ores.history" as history
component "ores.storage" as storage
component "ores.analytics" as analytics

api --> platform
api ..> utility

client --> api
client ..> refdata : currency pairs
client ..> nats : request and reply

core --> api
core ..> ore : ORE market-data files
core ..> dq : change reasons
core ..> history : version history
core ..> refdata : currency pairs
core ..> storage : series export
core ..> nats : entity events
core ..> database : tenant-scoped schema
core ..> service_lib : domain service base

service --> core
service ..> refdata : currencies
service ..> security : request verification
service ..> telemetry : service heartbeats
service ..> eventing : table change events
service ..> iam : session tokens
service ..> analytics : curve valuation
service ..> nats : subscriptions
service ..> database : tenant-scoped schema
service ..> service_lib : host runner

shell_marketdata ..> api : marketdata commands

@enduml
