@startuml

title ores.refdata.client Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace refdata #F2F2F2 {
        namespace client #F2F2F2 {
            namespace presentation #F2F2F2 {
                class currency_pair_rate_formatter {
                    {static} +format_rate(rate : double, convention : optional<ores::refdata::domain::currency_pair_convention>, convention_reversed : bool) : std::string
                }
                note top of currency_pair_rate_formatter
                Convention-aware FX rate formatting for every rate-display surface.
                end note
            }
        }
        namespace service #F2F2F2 {
            namespace cache #F2F2F2 {
                class currency_pair_convention_cache {
                    -nats_ : ores::nats::service::client&
                    -token_provider_ : std::function<std::string(bool)>
                    -cache_ : partitioned_cache<std::string, std::string, ores::refdata::domain::currency_pair_convention>
                    +set_token_provider(token_provider : std::function<std::string(bool)>)
                    +load(tenant_id : std::string) : std::string
                    +lookup(tenant_id : std::string, key : std::string) : std::optional<ores::refdata::domain::currency_pair_convention>
                }
                note top of currency_pair_convention_cache
                In-process per-tenant cache of currency-pair conventions, loaded over NATS and reloaded on changed events.
                end note
                class currency_pair_convention_cache_registrar {
                    +warm_and_subscribe_currency_pair_convention_cache(nats : ores::nats::service::client&, cache : std::shared_ptr<currency_pair_convention_cache>, tenant_ids : std::vector<std::string>) : ores::nats::service::subscription
                }
                note top of currency_pair_convention_cache_registrar
                Header-only free function: warms the cache per tenant, then subscribes to the changed-event subject.
                end note
                currency_pair_convention_cache_registrar ..> currency_pair_convention_cache : warms
            }
        }
    }
}

