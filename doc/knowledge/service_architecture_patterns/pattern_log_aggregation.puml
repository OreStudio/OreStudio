@startuml

title Log Aggregation: every service's lines reach places that can be searched together

skinparam componentStyle rectangle
component "service A" as a
component "service B" as b
component "service C" as c
database "systemd journal\n(per host)" as j
database "telemetry log store" as t
actor "operator" as op
a --> j : console
b --> j : console
c --> j : console
a --> t : log records (ingest)
b --> t
c --> t
op --> j : compass tails a unit
op --> t : the logs screen filters by time,\nlevel, source and correlation id
@enduml
