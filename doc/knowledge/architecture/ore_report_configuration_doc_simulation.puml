  }
  class "jarrowYildrim_RealRate" as simulation__jarrowYildrim_RealRate <<value>> {
  }
  class "lgm" as simulation__lgm {
    Currency? : currencyCode
    CalibrationType : calibrationTypeType
    FloatSpreadMapping? : floatSpreadMappingType
    ccy? : currencyCodeWithDefault
    index? : string
    key? : string
  }
  class "lgm_CalibrationBaskets" as simulation__lgm_CalibrationBaskets <<value>> {
  }
  class "localVol" as simulation__localVol {
    DomesticCcy : currencyCode
    Model : string
    StochasticRatesCorrection : string
    CalibrationMoneyness : string
    CalibrationGrid : string
    foreignCcy : currencyCodeWithDefault
  }
  class "simulation" as simulation__simulation {
  }
  enum "SobolBrownianGeneratorOrdering" as simulation__SobolBrownianGeneratorOrdering {
    Factors
    Steps
    Diagonal
  }
  enum "SobolRsgDirectionIntegers" as simulation__SobolRsgDirectionIntegers {
    Unit
    Jaeckel
    SobolLevitan
    SobolLevitanLemieux
    JoeKuoD5
    JoeKuoD6
    JoeKuoD7
    Kuo
    Kuo2
    Kuo3
  }
  enum "calibrationTypeType" as simulation__calibrationTypeType {
    Bootstrap
    BestFit
    None
    StatisticalWithRiskNeutralVolatility
  }
  enum "default" as simulation__default {
    default
  }
  enum "defaultCurveExtrapolation" as simulation__defaultCurveExtrapolation {
    FlatFwd
    FlatZero
  }
  enum "discretizationType" as simulation__discretizationType {
    Exact
    Euler
    BestMarginalDiscretization
  }
  enum "floatSpreadMappingType" as simulation__floatSpreadMappingType {
    NextCoupon
    ProRata
    Simple
  }
  enum "measureType" as simulation__measureType {
    LGM
    BA
    
  }
  enum "mporMode" as simulation__mporMode {
    ActualDate
    StickyDate
  }
  enum "paramTypeType" as simulation__paramTypeType {
    Constant
    Piecewise
  }
  enum "priceRollDown" as simulation__priceRollDown {
    Spot
    Forward
  }
  enum "reversionTypeType" as simulation__reversionTypeType {
    Hagan
    HullWhite
  }
  enum "salvagingAlgoType" as simulation__salvagingAlgoType {
    None
    Spectral
    Hypersphere
    LowerDiagonal
    Higham
  }
  enum "sequenceType" as simulation__sequenceType {
    MersenneTwister
    MersenneTwisterAntithetic
    Sobol
    SobolBrownianBridge
    Burley2020SobolBrownianBridge
  }
  enum "timeDecayType" as simulation__timeDecayType {
    ForwardVariance
    ConstantVariance
  }
  enum "volatilityTypeType" as simulation__volatilityTypeType {
    Hagan
    HullWhite
  }
  enum "ycExtrapolation" as simulation__ycExtrapolation {
    FlatFwd
    FlatZero
    Y
    YES
    TRUE
    True
    true
    1
    N
    NO
    FALSE
    False
    false
    0
    
  }
  enum "ycInterpolation" as simulation__ycInterpolation {
    LogLinear
    LinearZero
    LogCubic
  }
  enum "ycRollDown" as simulation__ycRollDown {
    ConstantDiscounts
    ForwardForward
  }
}

