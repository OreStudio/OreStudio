# The evidence script, step 3: the trader publishes the approved subject, tries
# the same request twice, and tries another as-of under the same approval.
#
# Run from the worktree with:
#   ./compass.sh shell -l <this file>
connect $ORES_NATS_URL

login henry.jones@acme_corporation Secure-Password-123

# 1. The approved subject, published: the set moves, and the record names who moved it.
curve_publish_operations publish-curve ${CONFIG_ID} 2026-10-27T12:00:00Z --approval_request_id ${REQUEST_ID}

# 2. The same request and subject again: one request publishes once.
curve_publish_operations publish-curve ${CONFIG_ID} 2026-10-27T12:00:00Z --approval_request_id ${REQUEST_ID}

# 3. The same request, another as-of: the request authorises one subject.
curve_publish_operations publish-curve ${CONFIG_ID} 2026-10-26T12:00:00Z --approval_request_id ${REQUEST_ID}

# 4. A request of the kind that names no subject, which the raise now refuses.
curve_publish_operations publish-curve ${CONFIG_ID} 2026-10-27T12:00:00Z --approval_request_id ${SUBJECTLESS_REQUEST_ID}

# 5. What a consumer of the subject reads.
curve_publishes by-request-id ${REQUEST_ID}

logout
