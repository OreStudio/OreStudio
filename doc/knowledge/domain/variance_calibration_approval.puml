@startuml
title What an approval does

actor Reviewer
participant "Calibration screen" as UI
participant "synthetic service" as S
database "Variance calibrations" as C
database "FX spot feeds" as F

Reviewer -> UI : approve, with a reason
UI -> S : review_variance_calibration\n(id, approve, reason)
S -> C : read the calibration
alt it is decided, and not an approval sent again
  S --> UI : refused: only a proposed\ncalibration is reviewed
else it is proposed, or an approval sent again
  opt it is proposed
    S -> C : supersede the pair's current approval\n(a new version, its reason names the new one)
    S -> C : approve the calibration\n(a new version, the reviewer's reason)
  end
  loop every GJR-GARCH feed of the pair\nnot already on it
    S -> F : name the approved calibration\n(a new version of the feed)
  end
  S --> UI : approved; the feeds now on it
end
== when a feed starts ==
F -> S : read the calibration the feed names
alt approved, and of the feed's pair
  S -> S : run its shape; the start record\nnames the calibration and its version
else missing, of another pair, not approved or shapeless
  S -> S : refuse to start, and say why
end
@enduml
