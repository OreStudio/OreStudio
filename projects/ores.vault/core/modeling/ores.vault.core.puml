@startuml

title ores.vault.core

set namespaceSeparator ::

namespace ores::vault::core {
    class secret_entity <<row>>
    class secret_repository
    class secret_service
}

secret_repository ..> secret_entity : maps
secret_service ..> secret_repository : reads and writes

note bottom of secret_service
