@startuml

title Admission and promotion: two tenants fire at the same minute

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

participant "ores.scheduler" as scheduler
participant "ores.reporting\n(trigger and admission)" as reporting
database "reporting store" as db
participant "ores.workflow" as engine

== 06:00: tenant A fires 500 jobs, tenant B fires 3 ==

loop for each firing, in any order
    scheduler -> reporting : reporting.v1.ops.trigger_report_instance\n(definition, tenant, firing id)
    reporting -> db : adopt the instance for the firing id, or insert it
    reporting -> db : count the running instances\nof the tenant and of the party
    alt under both quotas
        reporting -> db : state pending
        reporting -> engine : workflow.v1.ops.start_workflow
    else a quota is full
        reporting -> db : state queued
    end
    reporting --> scheduler : the instance id
end

note over reporting, db
  Tenant A: 20 pending, 480 queued.
  Tenant B: 3 pending. B does not wait behind A.
end note

== a run of tenant A reaches a terminal state ==

engine -> reporting : reporting.v1.ops.finalise_report\n(or reporting.v1.ops.fail_report)
reporting -> db : instance completed
reporting -> db : lock the oldest queued instance of tenant A\nwhose party is under its quota (skip locked)
alt a candidate exists
    reporting -> db : state pending
    reporting -> engine : workflow.v1.ops.start_workflow
end
reporting --> engine : step completed

== every minute ==

reporting -> db : promote, per tenant, while under quota
@enduml
