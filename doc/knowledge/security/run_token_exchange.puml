@startuml

title A step obtains the run token, and an owner reads as the tenant and the party

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

participant "ores.workflow" as engine
box "a step service replica"
participant "step handler" as handler
participant "run token cache" as cache
end box
participant "ores.iam" as iam
participant "an owner\n(for example ores.refdata)" as owner
database "the owner's store\n(row-level security)" as db

engine -> handler : step command\n(step id, instance id, tenant headers;\ngrant id and run id in the payload)
handler -> cache : get (grant id, run id)
alt a hit with more than 20% of its life left
    cache --> handler : run token
else a miss, or close to expiry
    cache -> iam : iam.v1.ops.exchange_run_grant\n(Authorization: the service's own token;\ngrant id, run id, tenant)
    iam -> iam : the caller holds iam::run_grants:exchange\nand is in the grant's audience
    iam -> iam : the grant is active, its tenant matches,\nand its grantor is active
    iam -> iam : permissions = the grant's role\nintersected with the grantor's permissions in the party
    iam -> iam : append to the issue log
    iam --> cache : signed token, expires in 5 minutes
    cache --> handler : run token
end
handler -> owner : operation request\n(Authorization: the run token)
owner -> owner : make_request_context: tenant T, party P,\nvisible parties {P}, the role's permissions
owner -> db : set the session tenant and party; read
db --> owner : the party's rows and the system tenant's shared rows
owner --> handler : response
handler -> engine : step completed

== the token expires during a long call ==

handler -> owner : operation request (an expired token)
owner --> handler : X-Error: token_expired
handler -> cache : invalidate, then exchange again
handler -> owner : the same request, once
@enduml
