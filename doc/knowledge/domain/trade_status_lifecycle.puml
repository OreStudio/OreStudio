@startuml
!pragma layout smetana

title Trade lifecycle

skinparam state {
    BackgroundColor #D6E8FA
    BorderColor #4A78A8
    FontColor #1A1A1E
    AttributeFontColor #3A3A3E
    ArrowColor #4A78A8
    ArrowFontColor #1A1A1E
    StartColor #4A78A8
    EndColor #4A78A8
}
skinparam note {
    BackgroundColor #FBF3D3
    BorderColor #C9A227
    FontColor #1A1A1E
}
skinparam BackgroundColor white
skinparam DefaultFontColor #1A1A1E

state "live" as Live
state "expired" as Expired
state "cancelled" as Cancelled

Live : The agreement stands
Expired : Contract ceased naturally
Cancelled : Removed from the book

[*] --> Live : New
Live --> Expired : Expiry
Live --> Cancelled : Cancellation

Live --> Live : Amend
Expired --> Expired : Amend
Cancelled --> Cancelled : Amend

Expired --> [*]
Cancelled --> [*]

note right of Live
  A trade is live from the moment it
  is booked. Whether it contributes to
  risk and P&L depends on its
  authorisation status, which is a
  separate attribute.
end note

note bottom of Cancelled
  Amend is a self-transition on every
  state, including the terminal ones:
  a cancelled or expired trade can
  still be corrected. What an amend
  produces is a version, not a
  different state.
end note

@enduml
