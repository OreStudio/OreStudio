@startuml

title Correlation Identifier: one id from the origin through every hop

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "person" as person
participant "origin\n(Qt, shell, HTTP edge,\nor a scheduler firing)" as origin
participant "service A" as a
participant "service B" as b
participant "workflow engine" as engine
participant "step service" as step
collections "logs" as logs

person -> origin : an action
origin -> origin : create id C
origin -> a : request (Nats-Correlation-Id: C)
a -> logs : every line of this request: correlation_id=C
a -> b : request (Nats-Correlation-Id: C)
b -> logs : every line: correlation_id=C
a -> engine : workflow.v1.ops.start_workflow (correlation id C, stored on the run)
a --> origin : reply (Nats-Correlation-Id: C)
... later, after a restart if need be ...
engine -> step : step command (Nats-Correlation-Id: C)
step -> logs : every line: correlation_id=C
note over logs : grep correlation_id=C\nreturns the whole trail
@enduml
