@startuml

title ores.http.reporting Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace http #F2F2F2 {
        namespace routes #F2F2F2 {
            namespace reporting #F2F2F2 {
                class reporting_routes {
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---

ores.http.api ..> ores.http.reporting : router, route builder, OpenAPI registry
ores.nats ..> ores.http.reporting : transport
ores.reporting.api ..> ores.http.reporting : protocol
ores.analytics.api ..> ores.http.reporting : pricing models and engines
ores.refdata.api ..> ores.http.reporting : book types, tenors and instrument codes

