@startuml

title An agent's write is held until its person and then a second person approve

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Agent" as agent
participant "ores.http" as http
participant "Domain service" as svc
participant "ores.inbox" as inbox
actor "Person" as person
actor "Second approver" as second

agent -> http : call_operation(write, arguments)
alt the grant is read only
  http --> agent : refused: the grant cannot write
else
  http -> svc : write, token with act = agent
  svc -> inbox : raise request:\npart 1 = the agent's person,\nthen the parts the policy names
  inbox --> svc : request id
  svc --> http : held, request id
  http --> agent : the write waits for approval: request id
end

person -> inbox : approve part 1
second -> inbox : approve the policy's parts\n(never the agent's person)
inbox -> svc : apply the held change
svc -> svc : write, recording the agent

@enduml
