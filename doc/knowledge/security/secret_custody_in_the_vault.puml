@startuml

@startuml

title The security kernel, the custody service, and the layers that link them

skinparam componentStyle rectangle
top to bottom direction

package "Application layer" {
    component "ores.http\n(the gateway's routes)" as http
    component "ores.shell" as shell
}

package "Domain layer" {
    package "ores.iam" {
        component "api" as iam_api
        component "core\n(identity, sessions, grants)" as iam_core
        component "service" as iam_service
        component "client" as iam_client
    }
    package "ores.vault" {
        component "api\n(protocol, sealed payloads)" as vault_api
        component "core\n(secretion, sealing, rotation)" as vault_core
        component "service\n(the vault process)" as vault_service
        component "client\n(the consumer's facade)" as vault_client
    }
}

package "Infrastructure layer" {
    component "ores.nats" as nats
    component "ores.service\n(the runner: token check)" as runner
}

package "Foundation layer" {
    component "ores.security\nhash, seal, sealed box,\ntoken, policy predicates" as kernel
    component "ores.database" as database
    component "ores.variability.core\n(a Foundation consumer)" as variability
}

http --> vault_client
iam_service --> iam_core
iam_core --> iam_api
vault_service --> vault_core
vault_core --> vault_api
vault_client --> vault_api
vault_core --> kernel
vault_service --> runner
vault_service --> nats
vault_core --> database
iam_core --> kernel
variability --> kernel

note right of vault_service
  The key that seals every secret
  is a system credential of this unit:
  it is not in the database, the
  checkout or the environment file.
end note

note bottom of kernel
  Every layer above links the kernel,
  so the kernel cannot move above
  Foundation.
end note

@enduml
