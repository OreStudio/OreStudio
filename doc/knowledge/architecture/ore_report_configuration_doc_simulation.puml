@startuml
title ORE simulation entities
hide empty members
skinparam classAttributeIconSize 0
skinparam nodesep 12
skinparam ranksep 24

package "simulation.xml" {
  class "boundaryConstraint" as simulation__boundaryConstraint {
    LowerBound : float
    UpperBound : float
    parameter : string
  }
  class "calibrationBasket" as simulation__calibrationBasket {
    parameter? : string
  }
  class "calibrationConfiguration" as simulation__calibrationConfiguration {
    RmseTolerance? : positiveDecimal
    MaxIterations? : positiveInteger
  }
  class "calibrationConfiguration_Constraints" as simulation__calibrationConfiguration_Constraints <<value>> {
  }
  class "calibrationCpiCapFloor" as simulation__calibrationCpiCapFloor {
    Type : capFloor
    Maturity : string
    Strike : string
  }
  class "calibrationYoYCapFloor" as simulation__calibrationYoYCapFloor {
    Type : capFloor
    Tenor : string
    Strike : string
  }
  class "calibrationYoYSwap" as simulation__calibrationYoYSwap {
    Tenor : string
  }
  class "cir" as simulation__cir {
    Currency? : currencyCode
    CalibrationType : calibrationTypeType
    CalibrationStrategy : string
    StartValue : float
    ReversionValue : float
    LongTermValue : float
    Volatility : float
    RelaxedFeller : bool
    FellerFactor : float
    Tolerance : float
  }
  class "commoditySchwartz" as simulation__commoditySchwartz {
    Currency : currencyCode
    CalibrationType : string
    DriftFreeState? : boolean
    name : string
  }
  class "crlgm" as simulation__crlgm {
    Currency? : currencyCode
    CalibrationType : calibrationTypeType
    FloatSpreadMapping? : floatSpreadMappingType
    name? : string
  }
  class "crossAssetLGM" as simulation__crossAssetLGM {
    Currency : currencyCode
    CalibrationType : string
    name : string
  }
  class "crossAssetModel" as simulation__crossAssetModel {
    DomesticCcy : currencyCode
    BootstrapTolerance : float
    Measure? : measureType
    Discretization? : discretizationType
    SalvagingAlgorithm? : salvagingAlgoType
    IntegrationPolicy? : string
    PiecewiseIntegration? : bool
  }
  class "crossAssetModel_Commodities" as simulation__crossAssetModel_Commodities <<value>> {
    Commodity? : string
  }
  class "crossAssetModel_CommodityModels" as simulation__crossAssetModel_CommodityModels <<value>> {
  }
  class "crossAssetModel_CreditModels" as simulation__crossAssetModel_CreditModels <<value>> {
  }
