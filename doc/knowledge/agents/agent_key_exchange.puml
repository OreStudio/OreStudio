@startuml

title A person makes a key in ores.web, and ores.http exchanges it for a short token

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Person" as person
participant "ores.web" as web
participant "ores.http" as http
participant "ores.iam" as iam
actor "Agent" as agent

person -> web : create a grant: agent name, scope, expiry
web -> http : POST grant, as the signed-in person
http -> iam : create grant and key
iam -> iam : store the key's prefix and hash
iam --> http : the key, once
http --> web : the key, once
web --> person : copy the key into the agent

== later, each call ==

agent -> http : request, Authorization: Bearer key
alt a token for this key is cached and fresh
  http -> http : use it
else
  http -> iam : exchange the key
  iam -> iam : find the grant by prefix, compare the hash;\ncheck it is active and the person is active
  iam --> http : token: sub = person, act = agent,\nscope, five minutes
end
http -> http : serve the request with the token

@enduml
