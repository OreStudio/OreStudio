@startuml

title ores.shell.analytics Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace shell #F2F2F2 {
        namespace app #F2F2F2 {
            namespace commands #F2F2F2 {
                class analytics_commands {
                    {static} +register_commands(root_menu : cli::Menu&, session : nats_client&)
                }
                class pricing_engine_type_commands {
                    {static} +register_commands(root_menu : cli::Menu&, session : nats_client&)
                }
                class pricing_model_config_commands {
                    {static} +register_commands(root_menu : cli::Menu&, session : nats_client&)
                }
                class pricing_model_product_commands {
                    {static} +register_commands(root_menu : cli::Menu&, session : nats_client&)
                }
                class pricing_model_product_parameter_commands {
                    {static} +register_commands(root_menu : cli::Menu&, session : nats_client&)
                }
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---

analytics_commands ..> pricing_engine_type_commands : registers
analytics_commands ..> pricing_model_config_commands : registers
analytics_commands ..> pricing_model_product_commands : registers
analytics_commands ..> pricing_model_product_parameter_commands : registers

ores.shell.api ..> ores.shell.analytics : parsed_args, command_feedback
ores.analytics.api ..> ores.shell.analytics : domain, messaging

