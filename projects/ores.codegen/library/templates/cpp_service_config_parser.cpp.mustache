    if (standard_service_options::wants_version(vm)) {
        version(info);
        return {};
    }

    const auto std_opts(standard_service_options::read_options(vm));
    options r;
    r.logging = std_opts.logging;
    r.nats = std_opts.nats;
    r.database = std_opts.database;
    return r;
}

