@startuml
@startuml

title ores.trading.scripting

skinparam shadowing false

package "ores.trading.scripting" {
  package "façade" {
    class parse_result {
      +tree : ASTNodePtr
      +diagnostics : vector<diagnostic>
      +parsed() : bool
    }
    class diagnostic {
      +severity : severity
      +code : string
      +start : optional<position>
      +end : optional<position>
      +message : string
      +subject : optional<string>
    }
    class diagnostic_code {
      +code : string_view
      +severity : severity
      +title : string_view
      +explanation : string_view
    }
    class "parse()" as parse_fn << (F,#AADDFF) function >>
    class "to_compiler_format()" as fmt_fn << (F,#AADDFF) function >>
  }
  package "ore (copied from ORE)" {
    class ScriptParser
    class ScriptGrammar
    class ASTNode
    class "to_script()" as to_script << (F,#DDDDDD) function >>
    class "generateRandomAST()" as gen << (F,#DDDDDD) function >>
  }
}

parse_fn --> ScriptParser : parses with
ScriptParser --> ScriptGrammar
ScriptGrammar --> ASTNode : builds
parse_fn --> parse_result
parse_result o-- diagnostic
diagnostic ..> diagnostic_code : code of
fmt_fn ..> diagnostic

@enduml
