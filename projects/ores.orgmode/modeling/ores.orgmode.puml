@startuml

title ores.orgmode Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace orgmode #F2F2F2 {
        namespace domain #F2F2F2 {
            class document <<struct>> {
                +keywords : vector<keyword>
                +file_properties : vector<property>
                +headings : vector<heading>
            }
            class heading <<struct>> {
                +level : unsigned int
                +title : string
                +id : optional<string>
                +properties : vector<property>
                +body_lines : vector<string>
                +bullet_lists : vector<vector<string>>
                +tables : vector<domain::table>
                +links : vector<link>
                +children : vector<heading>
            }
            class keyword <<struct>> {
                +key : string
                +value : string
            }
            class link <<struct>> {
                +target_id : string
                +text : string
            }
            class property <<struct>> {
                +key : string
                +value : string
            }
            class resolved_target <<struct>> {
                +id : string
                +path : string
                +title : string
                +type : string
            }
            class table <<struct>> {
                +headers : vector<string>
                +rows : vector<vector<string>>
            }
            class join_paragraph_lines <<function>> {
                +join_paragraph_lines(lines : const vector<string>&) : string
            }
            document *-- "0..*" heading
            document *-- "0..*" keyword
            document *-- "0..*" property
            heading *-- "0..*" heading
            heading *-- "0..*" property
            heading *-- "0..*" link
            heading *-- "0..*" table
        }
        namespace parser #F2F2F2 {
            class parse <<function>> {
                +parse(text : const string&) : domain::document
                +parse_file(path : const filesystem::path&) : domain::document
            }
            parse ..> ores::orgmode::domain::document : produces
        }
        namespace indexing #F2F2F2 {
            class resolver {
                -db_ : unique_ptr<sqlite3, handle_deleter>
            }
            note top of resolver
            Resolves id: links against the org-roam index that compass builds.
            - resolve(id : const string&) : optional<resolved_target>
            - resolve(l : const link&) : optional<resolved_target>
            end note
            resolver ..> ores::orgmode::parser::parse : uses
            resolver ..> ores::orgmode::domain::resolved_target : produces
        }
    }
}

