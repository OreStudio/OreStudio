@startuml

title The identity link: the issuer and subject, and the address as evidence

skinparam classAttributeIconSize 0

package "a tenant's identity rows" {
    class "identity provider" as provider {
        tenant
        issuer
        client id
        client secret: a name, never a value
        enabled
    }

    class "account" as account {
        username
        email address
        tenant, party, roles
    }

    class "identity link" as link {
        provider
        subject
        account
    }
}

class "the address\nthe provider sent" as address {
    evidence of nothing on its own
}

provider "1" -- "0..*" link : enables
link "0..*" -- "1" account : names
provider ..> address : reports
address ..> account : never matches
note bottom of address
  A workspace administrator can mint any
  address in the domain the workspace holds,
  so two equal addresses are two claims and
  not one person.
end note

@enduml
