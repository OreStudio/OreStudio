            }
            class market_data_client {
                -nats_ : ores::nats::service::nats_client&
            }
            namespace detail #F2F2F2 {
                class ore_key_to_subject <<function>> {
                    +call(ore_key : string, tenant_id : string, workspace_id : string, party_id : string) : string
                }
            }
        }
    }
}

