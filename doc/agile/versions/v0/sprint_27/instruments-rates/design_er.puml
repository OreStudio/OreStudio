      option_type : text
      payoff_type : text
      payoff_type_2 : text
      style : text
      exercise_date : date
      exercise_price : numeric
      automatic_exercise : text
      has_exercise_data : boolean
      has_payment_data : boolean
      has_settlement_data : boolean
  }

  entity ores_trading_instrument_option_premiums_tbl <<temporal>> #D8E4F0 {
    * tenant_id : uuid <<PK>>
    * trade_id : uuid <<PK, FK>>
    * sequence_number : int <<PK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
