title ores.telemetry.service Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace telemetry #F2F2F2 {
        namespace service #F2F2F2 {
            namespace app #F2F2F2 {
                class application {
                    +operator : application&
                }
                class application_exception {
                    -message_ : string
                }
                class host {
                }
                class nats_poller {
                    -monitor_host_ : string
                    -monitor_port_ : unsigned short
