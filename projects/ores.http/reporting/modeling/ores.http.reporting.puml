@startuml

title ores.http.reporting Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace http #F2F2F2 {
        namespace routes #F2F2F2 {
            namespace reporting #F2F2F2 {
                class choice_routes {
                    +choices_json(const vector<string>& report_types, const vector<string>& concurrency_policies, const vector<string>& regulatory_book_types) : string
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
                class report_routes {
                    +rows_json(const vector<ores::reporting::domain::report_definition>& definitions, const optional<vector<party_name>>& parties, const optional<vector<run_row>>& runs, const vector<health_row>& health, const optional<vector<count_row>>& counts, const optional<vector<fire_row>>& fires)
                    +write_of(const ores::reporting::domain::report_definition& definition, const edit_change& change) : ores::reporting::messaging::report_definition_write
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
                class reporting_routes {
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session, string storage_dir) : void
                }
                class result_routes {
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
                class run_file_routes {
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session, string storage_dir) : void
                }
                class run_routes {
                    +runs_json(vector<run_view> runs) : string
                    +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, ores::nats::service::nats_client& session) : void
                }
                namespace rollup #F2F2F2 {
                    class money <<struct>> {
                        +currency : string
                        +total : double
                        +stated : bool
                    }
                    class priced_trade <<struct>> {
                        +trade_id : string
                        +npv : double
                        +npv_currency : string
                        +npv_base : double
                        +has_npv_base : bool
                        +notional : double
                        +notional_currency : string
                        +counterparty : string
                        +counterparty_name : string
                        +book_id : string
                        +book_name : string
                    }
                    class aggregate_row <<struct>> {
                        +key : string
                        +name : string
                        +trades : size_t
                        +totals : vector<money>
                        +notional : vector<money>
                        +group : string
                        +is_group : bool
                        +previous : vector<money>
                        +change : vector<money>
                        +change_pct : vector<money>
                        +is_removed : bool
                        +depth : int
                    }
                    class change_set <<struct>> {
                        +change : vector<money>
                        +pct : vector<money>
                    }
                }
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---

ores.http.api ..> ores.http.reporting : router, route builder, OpenAPI registry
ores.nats ..> ores.http.reporting : transport
ores.reporting.api ..> ores.http.reporting : protocol
ores.refdata.api ..> ores.http.reporting : book types, tenors and instrument codes
ores.iam.api ..> ores.http.reporting : the caller's own parties
ores.compute.api ..> ores.http.reporting : the batch that ran a report

