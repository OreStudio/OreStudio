@startuml

title Bulkhead: isolated pools, so one source of load cannot take them all

skinparam componentStyle rectangle
package "step service replica" {
  component "pool: tenant A\n(at most k steps)" as pa
  component "pool: tenant B\n(at most k steps)" as pb
  component "pool: tenant C\n(at most k steps)" as pc
}
package "compute grid" {
  component "shared pool\n(per platform)" as shared
  component "dedicated pool\n(tenant D)" as ded
}
component "slow owner X" as x
pa --> x : waits
pb --> shared
pc --> shared
note bottom of pa : tenant A waits on X;\nB and C keep their own capacity
@enduml
