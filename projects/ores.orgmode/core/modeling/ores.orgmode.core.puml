@startuml

title ores.orgmode.core Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace orgmode #F2F2F2 {
        namespace repository #F2F2F2 {
            class knowledge_page_repository <<generated>>
        }
        namespace messaging #F2F2F2 {
            class registrar {
                +register_handlers(nats, ctx, verifier) : vector<subscription>
            }
            class knowledge_page_handler <<generated>>
            class publish_from_dq_handler {
                +handle(delivery) : void
            }
            registrar --> knowledge_page_handler : serves
            registrar --> publish_from_dq_handler : serves
            note bottom of publish_from_dq_handler
            Calls ores_orgmode_publish_knowledge_pages_from_dq_fn,
            which copies the DQ-staged pages into the system tenant.
            end note
        }
    }
}

ores::orgmode::messaging::knowledge_page_handler --> ores::orgmode::repository::knowledge_page_repository

@enduml
