@startuml

title ores.storage.service Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace storage #F2F2F2 {
        namespace app #F2F2F2 {
            class application {
            }
            class host {
            }
        }
        namespace config #F2F2F2 {
            class options {
            }
            class parser {
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---

' The service part carries the process shell the component scaffold generates:
' configuration, the host runner binding, and the application object. The
' object handler joins it as a class in messaging/ once the operation surface
' is modelled; the diagram gains it then rather than drawing a box that does
' not exist.
'
' The blocks below fill the empty boxes the automated pass drew.

class ores::storage::app::application #ECECEC {
    +run() : void
}
note right of "ores::storage::app::application"
Binds the service's subjects, through the registrar the
messaging layer supplies, and then hands control to the
host runner.
end note

class ores::storage::app::host #E8F5E9 {
    +host(options : options) : host
    +run() : void
}
note right of "ores::storage::app::host"
The binding to ores.service's host runner: connection,
signal handling and the shutdown path, none of which is
storage's business.
end note

class ores::storage::config::options #ECECEC {
    +nats_url : string
    +tenant_id : string
}
note right of "ores::storage::config::options"
What the process needs to start. Storage holds no bucket
name and no storage root of its own, so nothing about the
data it serves appears here.
end note

class ores::storage::config::parser #ECECEC {
    {static} +parse(argc : int, argv : char**) : options
    {static} +usage() : string
}
note right of "ores::storage::config::parser"
Command-line parsing, with the usage text the operator sees.
end note

ores::storage::app::application ..> ores::storage::app::host : runs under
ores::storage::app::host ..> ores::storage::config::options : configured by
ores::storage::config::parser ..> ores::storage::config::options : produces

