@startuml
autonumber
participant "fx_vol_surface_feed" as surface
participant "market_board" as values
participant "pair_market_at" as resolve
participant "fx_vol_surface_emitter" as emitter
participant "fx_vol_surface_generator" as engine
participant "NATS" as nats

surface -> values : view(curve:EUR), view(curve:USD), view(spot:EUR/USD)
values --> surface : spot date, dated discounts, level, when each was published
surface -> surface : merge the two curves into one dated discount row per day
loop each expiry the feed quotes
    surface -> resolve : pair_market_at(spot, spot_date, rows, value_date)
    resolve --> surface : the market: spot, P_dom, P_for
end
surface -> emitter : step(drivers, markets)
emitter -> engine : step(spot shock = 0, drivers)
engine --> emitter : the SSVI surface after the step
emitter -> emitter : read the smile at the strike of each delta
emitter --> surface : one observed point per contributor per point
surface -> nats : a tick per point per contributor
@enduml
