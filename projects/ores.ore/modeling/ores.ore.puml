@startuml

title ores.ore data model

set namespaceSeparator ::

legend right
  <<orm>>: a persisted table, generated from the entity model.
  Everything else is hand-written in ores.ore.core.
  The registry holds one shape per series type, and is
  built from the table at the start of an import.
endlegend

namespace ores #F2F2F2 {
    namespace ore #F2F2F2 {
        namespace domain #F2F2F2 {
            class series_key_shape <<orm>> {
                +series_type : string <<pk>>
                +qualifier_depth : int
                +has_point_dimension : bool
                +default_point : string
                +description : string
            }
        }
        namespace market #F2F2F2 {
            class series_key_registry {
                +decompose(key) : decomposed_key
                +has_point_dimension(series_type) : bool
                +default_point_for(series_type) : string
                +known_series_types() : vector<string>
            }
            class decomposed_key <<struct>> {
                +series_type : string
                +metric : string
                +qualifier : string
                +point_id : optional<string>
            }
        }
    }
}

ores::ore::market::series_key_registry o-- ores::ore::domain::series_key_shape : knows
ores::ore::market::series_key_registry ..> ores::ore::market::decomposed_key : produces

