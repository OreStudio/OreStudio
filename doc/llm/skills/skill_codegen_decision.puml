@startuml

title Codegen — may I touch this, and is it drifting?

skinparam ArrowColor #8AB4F8
skinparam BackgroundColor transparent
skinparam DefaultFontColor #E3E3E6
skinparam TitleFontColor #E3E3E6
skinparam TitleFontSize 16
skinparam ArrowFontColor #C9D1D9
skinparam ArrowFontSize 12
skinparam note {
    BackgroundColor #1A1A1E
    BorderColor #58A6FF
    FontColor #E3E3E6
}
skinparam activity {
    BackgroundColor #2A2A2E
    BorderColor #58A6FF
    FontColor #E3E3E6
    DiamondBackgroundColor #1A1A1E
    DiamondBorderColor #58A6FF
    DiamondFontColor #E3E3E6
}

start
:An artefact;
if (Does a codegen model exist,
or does the file carry the
generated marker?) then (generated)
  :Hand-editing is not a legal verb;
  note right
    The dispatcher must not
    offer it. The edit goes
    to the model or template.
  end note
  if (Does its feature combination
  match a named profile exactly?) then (yes)
    :Bind the profile;
  else (no)
    :Find the nearest profile
    by Hamming distance;
    if (Is the diff a gap,
    or a novel combination?) then (gap)
      :Close the gap;
    else (novel)
      :Name a new profile;
      note right
        Never leave loose knobs
        with no profile. Unnamed
        variability is
        indistinguishable
        from drift.
      end note
    endif
  endif
  :Regenerate;
  if (Is the tree dirty?) then (yes)
    :Artefact drift;
  else (no)
    :Zero-diff. Verified.;
  endif
else (hand-written)
  :Edit it directly;
endif
stop

@enduml
