@startuml

title The market data model

hide empty members
skinparam classAttributeIconSize 0

class Provider {
    code
    name
    kind : data_vendor | exchange | broker | reference
}
class Source {
    id
    name
    kind : live | replay | test | simulated | derived
}
class RateCard {
    components
}
class VendorInstrument {
    id_scheme
    external_id
    field
    minted : bool
}
class Mapping {
    effective period
}
class InternalItem {
    oresmd URI
}
class QuoteSeries {
    item
    provider
    party
}
class Observation {
    value
    vendor time
    source (information only)
}
class Party
class Subscription {
    rights : display | non_display | derived
    effective period
}
class Route {
    effective period
    audited change
}
class Composite {
    rule
}

Provider "1" -- "*" Source
Source "1" -- "0..1" RateCard
Provider "1" -- "*" VendorInstrument
VendorInstrument "1" -- "*" Mapping
Mapping "*" -- "1" InternalItem
QuoteSeries "*" -- "1" InternalItem
QuoteSeries "*" -- "1" Provider
QuoteSeries "*" -- "1" Party
QuoteSeries "1" -- "*" Observation
Party "1" -- "*" Subscription
Subscription "*" -- "1" Provider
Subscription "1" -- "1" Route
Route "*" -- "1" Source
Composite "1" -- "1" InternalItem : produces
Composite "1" -- "*" QuoteSeries : inputs

note right of Mapping
  Provider level. Every source of a provider
  publishes under the same vendor ids.
end note
note bottom of Route
  One active source per (party, provider).
end note

@enduml
