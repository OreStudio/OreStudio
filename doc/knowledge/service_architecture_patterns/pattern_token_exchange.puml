@startuml

title Token Exchange: a service trades a token it holds for one fit for the next call

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber


participant "a service" as svc
participant "IAM\n(the issuer)" as iam
participant "a target service" as tgt

svc -> iam : exchange\n(subject token, or a grant;\nthe actor: the service's own token;\nthe audience and the scope wanted)
iam -> iam : may this actor exchange for this subject?
iam -> iam : narrow the permissions to the scope asked;\nset a short lifetime
iam -> iam : record the issue
iam --> svc : new token\n(sub: the subject; act: the service;\naud: the target; short expiry)
svc -> tgt : request (Authorization: the new token)
tgt -> tgt : verify; act as the subject,\nwith the narrowed permissions
tgt --> svc : response

@enduml
