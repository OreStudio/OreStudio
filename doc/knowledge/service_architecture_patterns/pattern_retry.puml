@startuml

title Retry: try again only when the failure is transient and repeating is safe

start
repeat
  :call (after token_expired, renew the token first);
  if (succeeded?) then (yes)
    stop
  endif
  if (the failure is transient:\ntimeout, unavailable, token_expired?) then (no)
    :fail now with the error;
    note right: forbidden and bad_request\nwill not change by asking again
    stop
  endif
  if (is the operation safe to repeat?) then (no)
    :fail; a person decides;
    stop
  endif
  :wait: exponential back-off with jitter;
repeat while (attempts left and budget left?) is (yes) not (no)
:fail with the last error;
stop
@enduml
