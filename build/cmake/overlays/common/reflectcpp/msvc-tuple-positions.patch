--- a/include/rfl/internal/tuple/calculate_positions.hpp
+++ b/include/rfl/internal/tuple/calculate_positions.hpp
@@ -30,7 +30,23 @@
 
 template <class... Types>
 consteval auto calculate_positions() {
+#if defined(_MSC_VER) && !defined(__clang__)
+  // Keep the layout identical without a recursively growing Positions type.
+  constexpr std::array<unsigned long, sizeof...(Types)> sizes{sizeof(Types)...};
+  constexpr std::array<unsigned long, sizeof...(Types)> alignments{alignof(Types)...};
+  std::array<unsigned long, sizeof...(Types) + 1> positions{};
+  unsigned long offset = 0;
+  for (size_t i = 0; i < sizes.size(); ++i) {
+    const auto remainder = offset % alignments[i];
+    if (remainder != 0) offset += alignments[i] - remainder;
+    positions[i] = offset;
+    offset += sizes[i];
+  }
+  positions[sizes.size()] = offset;
+  return positions;
+#else
   return (Positions<0>{} + ... + PositionWrapper<Types>{}).to_array();
+#endif
 }
 
 }  // namespace rfl::internal::tuple
