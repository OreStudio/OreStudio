    factor1 : string
    factor2 : string
    index1? : string
    index2? : string
  }
  class "crossAssetModel_InterestRateModels" as simulation__crossAssetModel_InterestRateModels <<value>> {
  }
  class "crossCurrencyLGM" as simulation__crossCurrencyLGM {
    DomesticCcy : currencyCode
    CalibrationType : string
    foreignCcy : currencyCodeWithDefault
  }
  class "dodgsonKainth" as simulation__dodgsonKainth {
    Currency : currencyCode
    CalibrationType : calibrationTypeType
    index? : string
  }
  class "dodgsonKainth_CalibrationBaskets" as simulation__dodgsonKainth_CalibrationBaskets <<value>> {
  }
