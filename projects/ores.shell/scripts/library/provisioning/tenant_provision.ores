# How do I provision a tenant?
# Provision the logged-in bootstrap-mode tenant from the shell (the tenant stage on its own).
#
# GENERATED from doc/recipes/shell/provisioning/tenant_provision.org — do not edit by hand.
# Regenerate with: ./compass.sh build --direct tangle_shell_scripts
#
connect $ORES_NATS_URL
login super_admin Secure-Password-123
provision tenant --tenant-code example --tenant-name "Example Corp" --tenant-hostname example --tenant-admin-password Secure-Password-123 --profile empty_operational --param counterparty_size=small
logout
