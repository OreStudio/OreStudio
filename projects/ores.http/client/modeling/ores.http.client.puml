@startuml

title ores.http.client Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace http #F2F2F2 {
        namespace client #F2F2F2 {
            namespace net #F2F2F2 {
                class request_limits <<struct>> {
                    +timeout : chrono::milliseconds
                    +max_body_bytes : size_t
                }

                class response <<struct>> {
                    +status : unsigned
                    +content_type : string
                    +body : string
                }

                enum failure_kind {
                    bad_url
                    network
                    tls
                    timeout
                    too_large
                }

                class failure <<struct>> {
                    +kind : failure_kind
                    +message : string
                }

                interface transport {
                    +get(string_view url, const request_limits& limits) : expected<response, failure>
                }

                class beast_transport {
                    -options_ : options
                    +beast_transport(options o)
                    +get(string_view url, const request_limits& limits) : expected<response, failure>
                }

                transport <|.. beast_transport
                transport ..> response
                transport ..> failure
                failure --> failure_kind
            }
        }
    }
}

note bottom of beast_transport
  Boost.Beast and Asio, with OpenSSL for TLS.
  Checks the certificate and the host name;
  one deadline bounds the whole request.
end note

@enduml
