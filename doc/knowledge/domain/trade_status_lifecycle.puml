@startuml
!pragma layout smetana

title Trade lifecycle

skinparam state {
    BackgroundColor #D6E8FA
    BorderColor #4A78A8
    FontColor #1A1A1E
    AttributeFontColor #3A3A3E
    ArrowColor #4A78A8
    ArrowFontColor #1A1A1E
    StartColor #4A78A8
    EndColor #4A78A8
}
skinparam note {
    BackgroundColor #FBF3D3
    BorderColor #C9A227
    FontColor #1A1A1E
}
skinparam BackgroundColor white
skinparam DefaultFontColor #1A1A1E

state "live" as Live {
  state "unauthorised" as Unauthorised #F0E2D0 ##[bold]A87A4A
  state "authorised" as Authorised #F0E2D0 ##[bold]A87A4A

  Unauthorised : Exists; contributes to nothing
  Authorised : Contributes to risk and P&L

  [*] --> Unauthorised
  Unauthorised --> Authorised : Authorise
  Authorised --> Unauthorised : Un-authorise
}

state "expired" as Expired
state "cancelled" as Cancelled

Expired : Contract ceased naturally
Cancelled : Removed from the book

[*] --> Live : New
Live --> Expired : Expiry
Live --> Cancelled : Cancellation
Expired --> [*]
Cancelled --> [*]

note right of Live
  Amend is a self-transition on every
  state, including the terminal ones.
  A cancelled or expired trade can be
  corrected without being revived, and
  what an amend produces is a version
  rather than a different state.
end note

note bottom of Cancelled
  The substates of live are shown to
  place them, not to model them. They
  are not states of this machine: the
  trade carries an operational
  authorisation flag, whose own
  lifecycle has four values, and
  contribution follows from combining
  the two.
end note

@enduml
