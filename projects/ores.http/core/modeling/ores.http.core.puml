                }
            }
        }
        namespace site #F2F2F2 {
            class environment_tls <<struct>> {
                +ca : optional<string>
                +cert : optional<string>
                +key : optional<string>
            }
            class environment <<struct>> {
                +id : string
                +displayName : string
                +description : string
                +host : string
                +port : int64_t
                +subjectPrefix : string
                +httpBaseUrl : string
                +tls : environment_tls
                +nonProduction : bool
            }
            class shared_tls <<struct>> {
                +ca : string
                +cert : string
                +key : string
            }
            class developer_account <<struct>> {
                +username : string
                +label : string
                +description : string
            }
            class site_configuration <<struct>> {
                +active : string
                +environments : vector<environment>
                +tls : shared_tls
                +developerTools : bool
                +developerAccounts : vector<developer_account>
            }
            class loaded_site <<struct>> {
                +configuration : site_configuration
                +served : environment
                +source : string
            }
            class site_configuration_error {
            }
        }
        namespace stream #F2F2F2 {
            class change_event <<struct>> {
                +tenant : string
                +party : string
                +component : string
                +entity : string
            }
            class coalesced_frame <<struct>> {
                +tenant : string
                +party : string
                +component : string
                +entity : string
            }
            class change_coalescer {
                -mu_ : mutable mutex
                -dirty_ : set<key>
                +record(const change_event& event) : void
                +set_wake(function<void()> wake) : void
                +drain() : vector<coalesced_frame>
                +pending() : [[nodiscard]] size_t
            }
            class entity_event_address <<struct>> {
                +component : string
                +collection : string
                +action : string
            }
            class change_feed {
                -coalescer_ : change_coalescer&
                +notify(const ores::nats::message& message) : bool
            }
            class watch_set {
                -mu_ : mutable mutex
                -collections_ : unordered_set<string>
                +replace(unordered_set<string> collections) : void
                +contains(const string& collection) : [[nodiscard]] bool
            }
            class watch_registry {
                -mu_ : mutex
                -sets_ : unordered_map<string, weak_ptr<watch_set>>
                +open(const string& session) : [[nodiscard]] shared_ptr<watch_set>
                +watch(const string& session, unordered_set<string> collections) : bool
            }
            class stream_scope <<struct>> {
                +tenant : string
                +party : string
                +sees_all_parties : bool
                +watching : shared_ptr<const watch_set>
                +wants(const string& collection) : [[nodiscard]] bool
            }
            class change_subscription {
                -scope_ : stream_scope
                -mu_ : mutable mutex
                -pending_ : list<pending_frame>
                -pending_by_collection_ : unordered_map<string, list<pending_frame>::iterator>
                -capacity_ : size_t
                -closed_ : bool
                +push(string collection, string frame) : void
                +try_pop() : optional<string>
                +set_waker(function<void()> waker) : void
                +clear_waker() : void
                +close() : void
                +scope() : [[nodiscard]] const stream_scope&
                +closed() : [[nodiscard]] bool
                +size() : [[nodiscard]] size_t
            }
            class change_hub {
                -system_tenant_ : string
                -epoch_ : string
                -mu_ : mutable mutex
                -subscriptions_ : vector<shared_ptr<change_subscription>>
                -capacity_ : size_t
                -retention_ : size_t
                -next_id_ : uint64_t
                -retained_ : deque<retained_frame>
                +id_of(uint64_t sequence) : [[nodiscard]] string
                +read_id(string_view id) : optional<resume_point>
                +subscribe(stream_scope scope, optional<resume_point> resumed) : [[nodiscard]] shared_ptr<change_subscription>
                +publish(const string& tenant, const string& party, const string& collection, string frame) : void
                +open_streams() : [[nodiscard]] size_t
                -conflation_key(const string& tenant, const string& party, const string& collection) : string
            }
            class change_stream_source {
                +subscription_ : shared_ptr<change_subscription>
                +keep_alive_ : chrono::milliseconds
                +ready_ : deque<string>
                +keep_alive_(keep_alive) : ,
                +~change_stream_source()
                +size() : [[nodiscard]] optional<uint64_t>
                +read(span<char> into) : boost::asio::awaitable<size_t>
                +take_from_ready(span<char> into) : size_t
            }
            class change_pump {
                -coalescer_ : change_coalescer&
                -hub_ : change_hub&
                +pump() : size_t
            }
            class change_ticker {
                -pump_ : change_pump
                -coalescer_ : change_coalescer&
                -window_ : chrono::milliseconds
                -open_ : shared_ptr<window>
                -stopped_ : atomic<bool>
                -mu_ : mutable mutex
                -executor_ : shared_ptr<boost::asio::any_io_executor>
                +change_ticker(change_coalescer& coalescer, change_hub& hub, chrono::milliseconds window)
                +~change_ticker()
                +run(boost::asio::any_io_executor executor) : boost::asio::awaitable<void>
                +arm() : void
                +stop() : void
                +running() : [[nodiscard]] bool
                -post(function<void(const shared_ptr<window>&)> change) : void
            }
        }
    }
