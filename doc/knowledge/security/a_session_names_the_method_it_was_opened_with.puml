@startuml

title A session names the method it was opened with, and the token carries it

skinparam classAttributeIconSize 0

class "session" as session {
    account
    method: a password, or the provider that proved it
    amr: the methods the provider asserted
    idp: the issuer, when a provider proved it
    opened, last seen, ended
}

class "authentication event" as event {
    account
    method
    provider
    outcome
    when
}

class "token" as token {
    sub: the account
    amr
    idp
    ...
}

session "1" -- "1" token : carried as claims
session "1" -- "0..*" event : recorded as
note bottom of event
  The event is the record a person reads when
  the question is "how did this session come to
  be", and the reason a session ending has an
  account of what it was worth.
end note

@enduml
