@startuml

title An agent's booking is held for its person, then booked live and unauthorised for Operations to authorise

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Agent" as agent
participant "ores.http" as http
participant "ores.inbox" as inbox
actor "Person" as person
participant "ores.trading" as trading
actor "Operations\nauthoriser" as ops

agent -> http : book a trade, with its key
http -> inbox : raise iam.write_by_agent, with the agent's token
http -> http : hold the call
http --> agent : 202, the request waits for the person

person -> inbox : approve (the person alone)
inbox --> http : the request is approved
http -> trading : replay the booking as the person, act = agent
trading -> trading : trade live and unauthorised, recording the agent
trading -> inbox : raise operational authorisation, asked by the person
ops -> inbox : authorise (never the person, never the agent)
inbox -> trading : mark the trade authorised

@enduml
