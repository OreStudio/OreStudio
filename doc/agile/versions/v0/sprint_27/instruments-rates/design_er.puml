  entity ores_trading_instrument_options_tbl <<temporal>> #D8E4F0 {
    * tenant_id : uuid <<PK>>
    * trade_id : uuid <<PK, FK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
    * trade_activity_id : uuid <<FK>>
