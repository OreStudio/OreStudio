{
  "version": "report-run-discovery-1.0.0",
  "cases": [
    {
      "id": "chain-trade-total",
      "group": "tool-chaining",
      "intent": "read and add only the requested trade IDs in one common stored report",
      "profiles": ["replay", "model"],
      "turns": [{
        "message": "Sum the value of these trades: 11111111-1111-4111-8111-000000000005 and 11111111-1111-4111-8111-000000000006 from run 11111111-1111-4111-8111-000000000007 on 2026-11-06.",
        "replay": [{"error":"model_must_not_run"}],
        "expect": {"tool":"read_trade_results","evidenceOrder":["read_trade_results","read_trade_results","process_read_analysis"],"contains":["0.3 GBP"],"resultChecks":[{"path":"evidence.2.tradeIds","equals":["11111111-1111-4111-8111-000000000005","11111111-1111-4111-8111-000000000006"]}]}
      }]
    },
    {
      "id": "chain-npv-concentration",
      "group": "tool-chaining",
      "intent": "read stored book NPV and calculate concentration over verified contributors",
      "profiles": ["replay", "model"],
      "turns": [{
        "message": "Show base-currency NPV for book Fixture FX Book from run 11111111-1111-4111-8111-000000000007 on 2026-11-06 and show its top two contributors. Then calculate what share of those absolute NPVs came from the one largest contributor.",
        "replay": [{"tool":"plan_read_analysis","arguments":{"operation":"absolute_share","topCount":1}}],
        "expect": {"tool":"summarize_scope_results","statuses":["ok"],"evidenceOrder":["summarize_scope_results","process_read_analysis"],"contains":["66.67%","2026-11-06"],"resultChecks":[{"path":"evidence.1.value","equals":"66.67"}]}
      }]
    },
    {
      "id": "chain-npv-after-run-selection",
      "group": "tool-chaining",
      "intent": "preserve the dependent calculation when the user selects the report run",
      "profiles": ["replay", "model"],
      "turns": [{
        "message": "Show base NPV for book Fixture FX Book on 2026-11-06. What share of the displayed absolute NPVs comes from the largest 1 contributor?",
        "replay": [{"error":"model_must_not_run"}],
        "expect": {"selectionRequired":"runId","noTools":true}
      }, {
        "message": "11111111-1111-4111-8111-000000000007",
        "replay": [{"tool":"plan_read_analysis","arguments":{"operation":"absolute_share","topCount":1}}],
        "expect": {"tool":"summarize_scope_results","statuses":["ok"],"evidenceOrder":["summarize_scope_results","process_read_analysis"],"contains":["66.67%"]}
      }]
    },
    {
      "id": "chain-fx-changes",
      "group": "tool-chaining",
      "intent": "read a stored FX series and calculate consecutive changes from its rows",
