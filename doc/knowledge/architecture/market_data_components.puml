@startuml

title The market data service and its adapters

skinparam componentStyle rectangle
left to right direction

package "Adapters (system services, no tenant, no party)" {
    component "bloomberg-live\nkind: live" as bbl
    component "bloomberg-sim\nkind: simulated\n(ores.marketdata.synthetic)" as bbs
    component "lseg-live\nkind: live" as lsl
    component "bloomberg-replay\nkind: replay" as bbr
}

queue "NATS core\nmarketdata.v1.ingress.<adapter>.>" as ingress
queue "NATS request/reply\nmarketdata.v1.adapters.*" as control

package "ores.marketdata (the market data service)" {
    component "Catalogue\nproviders, sources, instruments,\nmappings" as cat
    component "Routing\nsubscriptions, party to source" as route
    component "Mapping" as map
    component "Quality and\nconflation" as qual
    database "Quote series store\n(item, provider, party)" as store
    component "Composites\n(rule per item)" as comp
    component "Fan-out" as fan
    component "Metering and cost\nevents, rate cards,\nrating, allocation" as meter
}

package "Consumers" {
    component "Party A\nroutes to bloomberg-sim" as pa
    component "Party B\nroutes to bloomberg-live" as pb
}

bbl --> ingress : ticks
bbs --> ingress : ticks
lsl --> ingress : ticks
bbr --> ingress : ticks
ingress --> map
map --> qual
qual --> store
store --> comp
comp --> store
store --> fan
fan --> pa : per-party stream
fan --> pb : per-party stream
fan --> meter : delivery events
route --> meter : subscription and\ndemand intervals
cat --> map
route --> control : demand set
control --> bbl
control --> bbs
control --> lsl
control --> bbr

@enduml
