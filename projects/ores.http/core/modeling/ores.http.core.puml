                +served_types() : [[nodiscard]] static span<const string_view>
                +serves(string_view entity_type) : [[nodiscard]] static bool
                +handle_history(const ores::http::domain::http_request& req, ores::nats::service::nats_client& session) : boost::asio::awaitable<ores::http::domain::http_response>
            }
            class site_routes {
                +register_routes(shared_ptr<ores::http::net::router> router, shared_ptr<ores::http::openapi::endpoint_registry> registry, optional<ores::http::site::loaded_site> site) : void
