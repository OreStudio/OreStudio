@startuml

title The publish path: from a bundle request to a published row

skinparam componentStyle rectangle

package "Callers" {
    [ores.shell\nbundles publish] as shell
    [tenant provisioning\nworkflow step] as prov
    [bootstrap\npopulate, as owner] as boot
}

package "ores.dq" {
    [publish handler\nauthorises dq::datasets:write] as ph
    [publish service\nmembers, dependency closure] as ps
    database "DQ registries\ndatasets, bundle members,\nartefact types, dependencies" as reg
}

package "ores.workflow" {
    [bundle_publish_workflow\none step per dataset] as wf
}

package "Target service" {
    [publish_from_dq_handler\nderives the function from\nthe subject] as th
}

package "PostgreSQL" {
    [publish function\nores_<c>_publish_<p>_from_dq_fn\nsecurity definer] as fn
    database "artefact table\nores_dq_<p>_artefact_tbl\nsystem tenant" as art
    database "owning tables\nores_<c>_<p>_tbl\ntarget tenant" as tgt
}

shell --> ph : dq.v1.ops.publish_bundle
prov --> ph : dq.v1.ops.publish_bundle
ph --> ps : bundle code, tenant, params
ps --> reg : reads members and edges
ph --> wf : starts one run
wf --> th : one step per dataset,\ndependency order
th --> fn : dataset, tenant, mode, params
fn --> art : reads the staged rows
fn --> tgt : writes the published row,\nwith its provenance
boot --> fn : at bring-up,\nwithout the bus

note bottom of art
  A dataset's rows always live in the
  system tenant, whatever tenant the
  publication writes into.
end note

note bottom of fn
  The only mechanism that writes a
  published row. A populate script
  must never write its table.
end note

@enduml
