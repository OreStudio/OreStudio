@startuml

title Package round trip: export, store, coordinate, apply

actor Operator
participant "export operation" as exp
participant "refdata owner\n(source)" as sref
participant "trading owner\n(source)" as strd
participant "object storage" as store
participant "import coordinator" as coord
participant "refdata owner\n(target)" as tref
participant "trading owner\n(target)" as ttrd

Operator -> exp : export portfolio at as_of
exp -> sref : export part (as_of, target)
sref -> sref : read rows in one transaction
sref -> store : PUT staging/refdata.zst\n(compressed entry)
sref --> exp : part record (owner, kind,\nformat, rows, checksum)
exp -> strd : export part (as_of, target)
strd -> strd : read rows in one transaction
strd -> store : PUT staging/trading.zst\n(compressed entry)
strd --> exp : part record (owner, kind,\nformat, rows, checksum)

exp -> store : PUT packages/{package_id}/manifest.msgpack
exp -> store : assemble archive by byte copy\n(one entry per part, manifest entry)
exp -> store : PUT packages/{package_id}/package.zip.zst
note over exp, store
  The manifest carries part records only.
  No row ever reaches the bus.
end note

Operator -> coord : import package {package_id}
coord -> store : GET manifest.msgpack
coord -> coord : validate version, target, owners,\npart records; read no part bytes
coord -> tref : apply bundle {package_id}\narchive URI, as_of, target,\nrefdata bundle: parts
tref -> store : GET archive entry refdata/*
tref -> tref : verify SHA-256, stream rows,\nvalidate, one unit_of_work
tref --> coord : refdata applied (rows)
coord -> ttrd : apply bundle {package_id}\narchive URI, as_of, target,\ntrading bundle: parts
ttrd -> store : GET archive entry trading/*
ttrd -> ttrd : verify SHA-256, stream rows,\nvalidate, one unit_of_work
ttrd --> coord : trading applied (rows)
coord --> Operator : per-part report (applied,\nrejected, failed, pending)

@enduml
