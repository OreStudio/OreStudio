@startuml

title How the workflow engine runs one report: the dispatch loop

participant "starter\n(trigger, or recovery\non restart)" as starter
participant "workflow engine\n(ores.workflow)" as wf
database PostgreSQL as db
participant "stage handler\n(ores.reporting, ores.ore\nor ores.compute)" as stage

starter -> wf : workflow.v1.ops.start_workflow\n{type, request_json}
wf -> wf : build_steps(request_json, tenant, correlation_id)\npure function; rebuilt on every dispatch
note right of wf : the run's configuration is an input here;\nit decides which phases are listed,\nincluding any substitutes.
wf -> db : persist workflow instance and its steps

loop each step, in order
    wf -> db : step state = in_progress
    note right of wf : persisted *before* the publish,\nso a restart can re-dispatch it
    wf -> stage : publish step.command_subject\nheaders: step id, instance id, tenant id\npayload: command_json
    alt the stage completes
        stage -> stage : do the work
        stage -> wf : workflow.v1.ops.step_completed\n{step, result}
        wf -> db : step state = completed
    else the stage cannot
        stage -> wf : workflow.v1.ops.step_completed\n{step, failed, reason}
        wf -> wf : compensation:\nwalk the completed steps in reverse
        wf -> stage : publish step.compensation_subject\n(report.fail)
        wf -> db : instance failed
        note right of wf : compensation is why every step\ncarries a compensation subject
    end
end

wf -> db : instance completed

== On restart ==

starter -> wf : recovery
wf -> db : read instances left in_progress
wf -> stage : re-dispatch every in_progress step\n(at-least-once delivery)
note over wf, stage : a stage can therefore run twice.\nEvery stage must converge, not accumulate.

@enduml
