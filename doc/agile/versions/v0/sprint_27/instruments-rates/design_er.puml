      currency : text
  }

  entity ores_trading_instrument_option_payment_dates_tbl <<temporal>> #D8E4F0 {
    * tenant_id : uuid <<PK>>
    * trade_id : uuid <<PK, FK>>
    * sequence_number : int <<PK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
    * trade_activity_id : uuid <<FK>>
