salt
{
  <b>CHANGE SOMEONE'S DETAILS</b>
  --
  Person  [ jdoe                    ] [ Find ]
  --
  {#
    Photo and identity | Contact details
    [ my photo ] | Address    1 Example Street
    Username    jdoe | City       London
    Full name   Jane Doe | Postcode   EC2V 7HH
    Job title   Risk Analyst | Phone      +44 20 7000 0000
    Reports to  R. Smith | Email      jane.doe@example.com
    . | Web        example.com
  }
  --
  Edited by a tenant administrator, under iam::accounts:update.
  --
  [ Save ] | [ Cancel ]
}

@enduml
