# The tool versions of the Linux CI image, and of the continuous build that
# installs the same tools without the image. This file is the one place they
# are stated.
#
# To move to a new compiler or tool:
#   1. Change its line below.
#   2. Run build/docker/ci/build.sh. It builds the image and prints its tag.
#   3. Commit this file with the change.
#
# LLVM_MAJOR takes the newest point release of that major from apt.llvm.org.
# GCC_MAJOR gives clang its C++ standard library: clang uses the newest GCC
# it finds.
UBUNTU_VERSION=24.04
LLVM_MAJOR=19
GCC_MAJOR=14
CMAKE_VERSION=4.4.5
NINJA_VERSION=1.13.1
NODE_VERSION=22.23.4
PG_MAJOR=18
