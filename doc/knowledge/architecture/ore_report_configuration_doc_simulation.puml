    index? : string
    key? : string
  }
  class "hw_Reversion" as simulation__hw_Reversion <<value>> {
    Calibrate : bool
    ReversionType? : reversionTypeType
    ParamType : paramTypeType
    TimeGrid : string
  }
  class "hw_Volatility" as simulation__hw_Volatility <<value>> {
    Calibrate : bool
    VolatilityType? : volatilityTypeType
    ParamType : paramTypeType
    TimeGrid : string
  }
