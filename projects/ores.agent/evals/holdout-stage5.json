    {
      "id": "holdout-historical-fx",
      "group": "market",
      "intent": "read_historical_fx",
      "profiles": [
        "replay",
        "model",
        "live"
      ],
      "capability": {
        "status": "available"
      },
      "turns": [
        {
          "message": "Give the recorded EUR/USD spot from ore as of 30 December 2016.",
          "replay": [
            {
              "tool": "read_fx_spot",
              "arguments": {
                "baseCurrency": "EUR",
                "quoteCurrency": "USD",
                "provider": "ore",
                "asOf": "2016-12-30"
              }
            }
          ],
          "expect": {
            "tool": "read_fx_spot",
            "contains": [
              "1.0552",
              "2016-12-30"
            ],
            "statuses": [
              "ok"
            ],
            "arguments": {
              "baseCurrency": "EUR",
              "quoteCurrency": "USD",
              "provider": "ore",
              "asOf": "2016-12-30"
            },
            "checks": [
              {
                "path": "observation.value",
                "equals": "1.0552"
              },
              {
                "path": "observation.observedAt",
                "equals": "2016-12-30T00:00:00.000Z"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "holdout-report-command",
      "group": "unsupported",
      "intent": "refuse_report-command",
      "profiles": [
        "replay",
        "model",
        "live"
      ],
      "capability": {
        "status": "blocked_backend",
        "reason": "Current agent has no approved command capability; this evaluation never triggers reports or books trades."
      },
      "turns": [
        {
          "message": "Could you execute a new NPV report for my books?",
          "replay": [
            {
              "content": "This is a read-only assistant; execution and booking are not available."
            }
          ],
          "expect": {
            "noTools": true,
            "noFigures": true,
            "anyContains": [
              "read-only",
              "not available",
              "cannot book",
              "cannot execute",
              "not supported"
            ],
            "notContains": [
              "Booking complete",
              "I have booked",
              "I have submitted",
              "I have executed",
              "I have triggered",
              "Order submitted",
              "Report created"
            ]
          }
        }
      ]
    },
    {
      "id": "holdout-booking-command",
      "group": "unsupported",
      "intent": "refuse_booking-command",
      "profiles": [
        "replay",
        "model",
        "live"
      ],
      "capability": {
        "status": "blocked_backend",
        "reason": "Current agent has no approved command capability; this evaluation never triggers reports or books trades."
      },
      "turns": [
        {
          "message": "Please place a new EURUSD forward trade now.",
          "replay": [
            {
              "content": "This is a read-only assistant; execution and booking are not available."
            }
          ],
          "expect": {
            "noTools": true,
            "noFigures": true,
            "anyContains": [
              "read-only",
              "not available",
              "cannot book",
              "cannot execute",
              "not supported"
            ],
            "notContains": [
              "Booking complete",
              "I have booked",
              "I have submitted",
              "I have executed",
              "I have triggered",
              "Order submitted",
              "Report created"
            ]
          }
        }
      ]
    },
