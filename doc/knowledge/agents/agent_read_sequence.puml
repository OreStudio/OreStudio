@startuml

title An agent reads: the key becomes the person's token, and the route serves it as for the person

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Agent" as agent
participant "ores.http\n/mcp" as mcp
participant "ores.iam" as iam
participant "ores.http\nroute" as route
participant "Domain service" as svc

agent -> mcp : tools/call call_operation(name, arguments)\nAuthorization: Bearer key
mcp -> iam : exchange key
iam --> mcp : token: sub = person, act = agent:grant, session
mcp -> mcp : find the operation in the catalogue;\ncheck the person may call it
mcp -> route : request with the token
route -> svc : NATS request with the token
svc --> route : reply
route --> mcp : response
mcp --> agent : result, cut to a size a model can read

@enduml
