@startuml
!pragma layout smetana

title External machine: the commercial spine

skinparam state {
    BackgroundColor #E3F0DC
    BorderColor #4C7A44
    FontColor #1A1A1E
    AttributeFontColor #3A3A3E
    ArrowColor #4C7A44
    ArrowFontColor #1A1A1E
    StartColor #4C7A44
    EndColor #4C7A44
}
skinparam note {
    BackgroundColor #FBF3D3
    BorderColor #C9A227
    FontColor #1A1A1E
}
skinparam BackgroundColor white
skinparam DefaultFontColor #1A1A1E

state "unconfirmed" as Unconfirmed
state "affirmed" as Affirmed
state "queried" as Queried
state "confirmed" as Confirmed

Unconfirmed : Terms not yet agreed
Affirmed : Both sides agree the terms
Queried : The two records differ
Confirmed : Binding written record

[*] --> Unconfirmed : Book
Unconfirmed --> Affirmed : Affirm
Unconfirmed --> Queried : Query
Queried --> Affirmed : Resolve
Affirmed --> Confirmed : Confirm
Confirmed --> Unconfirmed : Confirmable amendment

note right of Confirmed
  Confirmed as of an external version.
  A confirmable amendment moves the
  external version and returns the
  trade here for re-confirmation.
end note

note bottom of Unconfirmed
  An unconfirmed trade is a
  counterparty risk: the terms are
  not yet enforceable in the form
  the parties agreed.
end note

@enduml
