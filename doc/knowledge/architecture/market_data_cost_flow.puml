@startuml

title From usage events to a bill for each party

left to right direction
skinparam componentStyle rectangle

component "Subscription intervals\n(party, provider, source, rights)" as e1
component "Demand intervals\n(party, instrument)" as e2
component "Delivery counts\n(party, instrument)" as e3
component "Access audit\n(user counts, later)" as e4

component "Rate card\nof the source" as rc
component "Rating\napply the card to one period" as rate
component "Source bill\nthe system's cost" as bill
component "Allocation\nby the driver of each component" as alloc
component "Party bill\nshadow bill when the source is simulated" as pbill

e1 --> rate
e2 --> rate
e3 --> rate
e4 --> rate
rc --> rate
rate --> bill
bill --> alloc
e1 --> alloc
e2 --> alloc
e3 --> alloc
alloc --> pbill

@enduml
