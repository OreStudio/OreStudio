@startuml

title ores.web Component

skinparam backgroundColor #FEFEFE

actor "Person" as person

package "ores.web — TypeScript, npm workspaces" #F2F2F2 {
    component "@ores/web\nReact browser client" as web
    component "@ores/bff\nFastify backend-for-frontend\nsession cookie and mTLS" as bff
    component "@ores/contracts\nshared HTTP shapes" as contracts
    component "@ores/wire-protocol\nmsgpack codec, subjects, schemas, mTLS" as wire
}

component "NATS broker" as nats
component "ores.iam.service" as iam
component "ores.refdata.service" as refdata
component "other ores.* services" as others

person --> web : HTTP
web --> bff : HTTP /api
web --> contracts
web --> wire : browser subset
bff --> contracts
bff --> wire
bff --> nats : request/reply over mTLS
nats --> iam
nats --> refdata
nats --> others

@enduml
