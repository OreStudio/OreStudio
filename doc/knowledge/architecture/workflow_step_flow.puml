@startuml

title The life of a step: what the engine decides when a step completes

start
:step_completed_event arrives on\nworkflow.v1.ops.step_completed;

if (is the step still in_progress?) then (no)
    :ignore the duplicate completion;
    stop
else (yes)

    if (did the step succeed?) then (no)
        :record the step failed;
        if (which failure policy does the definition declare?) then (compensate)
            :record the run compensating;
            stop
        else (stop-and-retry)
            :leave the run parked on the failed step;\nthe completed steps are kept;\na retry re-dispatches the failed step\nunder its same step identity;
            stop
        endif
    else (yes)

        :record the step completed;
        if (is there a next step?) then (yes)
            :persist the next step and publish its command\n(the step, the instance and the tenant);
            stop
        else (no)
            :record the instance completed;
            :publish ores.workflow.workflow_instance_changed;
            stop
        endif

    endif

endif

@enduml
