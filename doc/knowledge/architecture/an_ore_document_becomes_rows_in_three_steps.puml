@startuml

title One value: as ORE wrote it, as the mapper stored it, as the set judges it

actor "document" as caller
participant "projection\nread" as codec
participant "projection\nmap" as map
participant "entity mapper" as mapper
database "ores_refdata_*_configs_tbl" as db
participant "validate_curve_values_fn" as guard

caller -> codec : curveconfig.xml, MF
codec --> map : record, rendering as written
map --> mapper : rows, rendering as written
mapper -> mapper : stored_business_day_convention(MF)\n= ModifiedFollowing
mapper -> db : insert ModifiedFollowing
db -> guard : before insert
guard -> guard : ores_reporting_value_in_set_fn(set, value)
guard --> db : accept, or raise naming the set

@enduml
