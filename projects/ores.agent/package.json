{
  "name": "@ores/agent",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node build/agent.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "eval": "npm run build && node evals/run.mjs",
    "verify": "npm run format:check && npm test && node evals/check.mjs",
    "eval:compare": "node evals/compare.mjs",
    "eval:doctor": "npm run build && node evals/preflight.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.0",
    "esbuild": "0.27.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@msgpack/msgpack": "3.1.3",
    "markdown-it": "15.0.3",
    "nats": "2.29.3",
    "zod": "4.6.6"
  }
}
