@startuml

title Public fixings: from a publisher to the fixing store

skinparam componentStyle rectangle

package "Publishers (catalogue, kind reference)" {
    component "ECB, Bank of England, Bank of Canada,\nFRED, IMF and the other publishers" as publishers
}

package "Suppliers" {
    component "Frankfurter, ECB Data Portal,\nFRED, BoE, Treasury" as suppliers
    component "Session\none configured adapter each,\ne.g. frankfurter-eu" as session
}

component "Public sources adapter\nbackfill on start, then daily" as adapter

package "ores.marketdata" {
    interface "announce, demand,\ntick, heartbeat" as contract
    component "Mapping\nsupplier id to oresmd item" as mapping
    component "Fixing ingest\ndurable path, no age check,\nretried, never shed" as ingest
    database "market_fixing\nfixing series of each index,\nkept with no retention" as store
}

component "Readers of fixings\nlatest on or before a date,\nor a window" as readers

publishers --> suppliers : a feed binds a publisher\nto a supplier session
suppliers --> session
session --> adapter : fetch in the\nsupplier's notation
adapter --> contract
contract --> mapping
mapping --> ingest : an item that is\nan index is a fixing
ingest --> store
readers --> store : read

@enduml
