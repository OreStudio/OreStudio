@startuml

title The life of a step: from the start message to the finished run

actor "Tenant\nadministrator" as admin
participant "iam.v1.ops.provision_tenant\nhandler" as caller
participant "workflow engine" as engine
database "the run state" as db
participant "step handler\n(an operation)" as step

admin -> caller : provision tenant
caller -> caller : create the tenant and its administrator;\nmint the instance identifier
caller -> engine : publish start_workflow_message\n(workflow.v1.ops.start_workflow; the instance identifier\nis set; no reply subject)
caller --> admin : the provision answer\n(the instance identifier, the tenant identifier\nand the account identifier)

note over caller, engine
    The caller is answered before the run finishes.
    The start message carries no reply subject, so the
    reply above does not wait for the engine.
end note

engine -> engine : build the step list\n(from the run's request, the tenant\nand the correlation identifier)
engine -> db : record the run in progress\n(with its step count and its step list)
engine -> db : record the first step in progress
engine -> step : publish the step command\n(the step, the instance and the tenant)
step -> step : do the work
step -> engine : step_completed_event\n(the step identifier echoes the command)
engine -> db : record the step completed;\nkeep its result

alt the step reported completed or completed_with_warnings

    engine -> engine : take the next position
    loop each remaining step, until the last
        engine -> db : record the new step in progress
        engine -> step : publish the step command\n(the step, the instance and the tenant)
        step -> engine : step_completed_event
        engine -> db : record the step completed
    end
    engine -> db : record the run completed\n(with the last step's result)
    engine -->> caller : asynchronously: ores.workflow.workflow_instance_changed\n(the reply above left before the run finished)

else the step reported failed

    engine -> db : record the step failed

    alt the definition chooses the compensate policy

        engine -> db : record the run compensating
        loop every completed forward step, in reverse
            engine -> step : publish the compensation subject
            step -> engine : step_completed_event
        end
        engine -> db : record the run compensated;\nclear the run's error

    else the definition chooses the stop-and-retry policy

        engine -> db : record the run failed;\nthe failed step stays failed,\nevery completed step untouched
        note right of engine
            The run parks on the failed step.
            A retry re-dispatches that step under
            its same step identity and keeps the rest.
        end note

    end

end

@enduml
