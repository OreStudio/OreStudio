@startuml

title Scheduled Work Acting as a Tenant: grant, exchange and cache together

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber


actor "person" as person
participant "owning service" as owner
participant "IAM" as iam
participant "scheduler" as sched
participant "workflow engine" as engine
participant "step service\n(with a token cache)" as step
participant "data owner" as data

== once: consent (Grant Management) ==
person -> owner : schedule (the person's token)
owner -> iam : create a grant on behalf of the person
iam --> owner : grant id
owner -> sched : put the job (tenant, party)
== each firing: no caller ==
sched -> owner : trigger (scheduler's own token: Client Credentials)
owner -> engine : start (run id, grant id; no token)
engine -> step : step command (grant id, run id)
== each step: Token Exchange behind a cache ==
step -> step : cache hit for (grant id, run id)?
step -> iam : on a miss: exchange\n(the step's own token, grant id, run id)
iam --> step : run token (tenant, party, narrow role, minutes)
step -> data : request (Authorization: the run token)
data --> step : the tenant's and the party's rows
step --> engine : step completed

@enduml
