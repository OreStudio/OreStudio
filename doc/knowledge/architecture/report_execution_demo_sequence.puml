@startuml

title Report execution, demo mode: a vendored bundle through the real grid

actor Operator
participant "ores.scheduler" as sched
participant "ores.reporting" as rep
database PostgreSQL as db
participant "workflow engine\n(ores.workflow)" as wf
participant "ores.compute" as comp
participant "NATS\nJetStream" as js
participant "wrapper node" as node
participant "ORE engine" as engine
participant "ores.storage" as store

== Seeded once, outside the run ==
Operator -> store : PUT /api/v1/storage/ores/compute/packages/\nORE-1.8.17.0/ORE-1.8.17.0-x64-linux.tar.gz
Operator -> store : PUT /api/v1/storage/ores/reporting/demo/\nTA002_IR_Swap.tar.gz  (root holds Input/ore.xml)
Operator -> db : report type, report definition (execution_mode = demo),\nrisk report config, book scope, compute app version, scheduler job

== A schedule fires ==
sched -> db : insert job instance (starting)
sched -> rep : reporting.v1.ops.trigger_report_instance\n{report_definition_id, tenant_id, job_instance_id}
note over sched, rep : authenticated request; the scheduler\ncarries its own service token
rep -> db : insert report instance (pending), resolve execution_mode
rep -> wf : workflow.v1.start\n{type, request_json: definition, instance, mode = demo}
rep --> sched : outcome ok
sched -> db : job instance succeeded

== The chain the mode selects ==
wf -> wf : build_steps(request_json)\nmode = demo selects the short chain

wf -> rep : reporting.v1.report.provide-input\n(demo provider: the vendored tarball already exists)
rep -> store : HEAD /api/v1/storage/ores/reporting/demo/\nTA002_IR_Swap.tar.gz
store --> rep : exists
rep -> wf : workflow.v1.events.step-completed\n{step_index 0, input_uri}

wf -> comp : compute.v1.report.submit\n{report_instance_id, tenant_id, correlation_id, tarball_uris}
comp -> db : insert batch (open), workunit, result (Unsent)
comp -> js : compute.v1.work.assignments.{tenant_id}.{platform_code}\n{result_id, workunit_id, package_uri, sha256,\ninput_uri, output_uri}
comp -> db : batch dispatched
comp -> wf : workflow.v1.events.step-completed\n{step_index 1, batch_id}

== The grid runs the engine ==
js -> node : deliver assignment
node -> store : GET package_uri
node -> store : GET input_uri
note over node : extract; spawn the engine with the\njob directory as working directory
node -> engine : spawn (args: Input/ore.xml)
engine --> node : Output/
node -> store : PUT /api/v1/storage/ores/compute/output/{result_id}.tar.gz
node -> comp : compute.v1.results.submit\n{result_id, host_id, output_uri, outcome}
comp -> db : result Done, workunit canonical, batch closed

== The result comes back ==
wf -> rep : reporting.v1.report.collect-compute-results
rep -> comp : compute.v1.results.list (by report instance)
comp --> rep : result, output_uri
rep -> db : record the output location on the instance
rep -> wf : workflow.v1.events.step-completed\n{step_index 2, output_uri}

wf -> rep : reporting.v1.report.finalise
rep -> db : instance completed
rep -> wf : workflow.v1.events.step-completed\n{step_index 3}

Operator -> rep : report_instances get\n(instance, state, output location)
note over rep : demo mode stops here. The output archive\nis fetched with the shell, not imported.

@enduml
