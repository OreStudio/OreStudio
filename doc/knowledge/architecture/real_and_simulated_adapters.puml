@startuml

title A live adapter and the simulator behind the same contract

skinparam componentStyle rectangle

package "Adapter contract (identical)" as contract {
    interface "announce" as i1
    interface "demand" as i2
    interface "ingress ticks" as i3
    interface "heartbeat" as i4
}

package "bloomberg-live" {
    component "Session manager\nblpapi, credentials" as sess
    component "Vendor translation\nfield and id handling" as tr
}

package "bloomberg-sim (ores.marketdata.synthetic)" {
    component "Generator runner\nprocesses, vintage anchors" as gen
    component "Fault injection\ndrops, delays, bad ticks" as fault
    component "Authoring\ncollections, folders, preview" as auth
}

sess --> tr
tr --> i3
tr --> i2
gen --> fault
fault --> i3
gen --> i2
auth ..> gen : generators
sess ..> i4
gen ..> i4

note bottom of contract
  Everything above this line differs.
  Everything below it, in ores.marketdata, is the same.
end note

@enduml
