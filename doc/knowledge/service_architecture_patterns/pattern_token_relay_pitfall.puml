@startuml

title Token Relay: the pitfall of calling with the service's own identity


skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "caller\n(tenant T, party P)" as caller
participant "service A" as a
participant "service B" as b
database "B's store\n(row-level security)" as db

caller -> a : request (the caller's token)
group wrong: Client Credentials for a caller's data
    a -> b : request (Authorization: A's own token only)
    b -> b : context: the service's identity,\nno tenant, no party
    b -> db : read
    db --> b : no rows, and no error
    b --> a : an empty answer that looks like\n"the data does not exist"
end
group right: Token Relay
    a -> b : request (A's token;\nX-Delegated-Authorization: the caller's token)
    b -> b : context: tenant T, party P
    b -> db : read
    db --> b : the party's rows
    b --> a : the caller's data
end
a --> caller : response
@enduml
