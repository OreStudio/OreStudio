-- allium: 3
-- shell-compute-grid-management.allium

-- Scope: manage the compute grid from the ores.shell command line.
-- Includes:
--   - Read verbs: list apps, app versions, platforms, hosts and
--     batches, plus per-node grid telemetry (grid-stats)
--   - Job lifecycle: add a batch, dispatch its jobs (one shared
--     input bundle per batch), list workunits and results
--   - Grid monitoring: per-node grid stats, delete a host
--   - Artifact access: download a job's input bundle and a result's
--     output bundle
--   - The grid smoke test: dispatch 10-20 consecutive jobs and
--     verify every online node was exercised with all outcomes
--     successful
-- Excludes:
--   - The compute service internals: assignment, result submission
--     handling, storage layout -- existing behavior, unchanged
--   - The wrapper's package download and execution (ores.compute.wrapper)
--   - App and app-version registration: publish-package already
--     covers it -- the verbs here only list
--   - The desktop client and process-workflow verbs (the shell
--     workflow menu is a separate domain)
-- External inputs: grid state produced by the compute service and the
-- wrappers (host heartbeats, result submissions, storage bundles,
-- node samples).

config {
    -- Decisions (2026-08-10):
    --   Smoke size: 10-20 jobs. Ten consecutive jobs exceed the six
    --     online nodes of the brave_hopper grid, so a drained smoke
    --     batch cannot pass by luck of a single node.
    --   Offline threshold: 90s. The wrapper heartbeats every 30s;
    --     three missed beats declare a host offline.
    --   Table support: every entity the surface exposes must have a
    --     codegen table renderer; the shell never formats a row
    --     itself. Platform lacks one today; list-platforms prints
    --     raw rows until the ores.compute drift task generates the
    --     renderer, then the story's reconciliation task streams it
    --     (2026-08-10).
    smoke_min_jobs: Integer = 10
    smoke_max_jobs: Integer = 20
    heartbeat_timeout: Duration = 90.seconds
}

-- The operator drives the grid from the shell. Identity lives in the
-- IAM session, outside this spec.
entity GridOperator {
    name: String
}

-- ------------------------------------------------------------
-- Entities
-- ------------------------------------------------------------

-- The app catalogue (ores_compute_apps_tbl). Registered by
-- publish-package, outside this spec's rules; the shell only lists
-- it.
entity ComputeApp {
    id: String
    name: String
    description: String
    modified_by: String
    recorded_at: Timestamp

    versions: ComputeAppVersion with app = this
}

-- Registered app versions (ores_compute_app_versions_tbl). The
-- platform association lives on the app-version-platform junction,
-- which the list verbs do not render.
entity ComputeAppVersion {
    id: String
    app: ComputeApp
    wrapper_version: String
    engine_version: String
    min_ram_mb: Integer
    modified_by: String
    recorded_at: Timestamp
}

-- System-owned platform triplets (ores_compute_platforms_tbl): owned
-- by the system tenant, visible read-only to all tenants.
entity Platform {
    id: String
    code: String           -- e.g. "x64-linux"
    display_name: String   -- e.g. "Linux x86-64"
    description: String
    os_family: `linux` | `macos` | `windows`
    cpu_arch: `x86_64` | `aarch64`
    abi: `gnu` | `musl` | `msvc` | `mingw`?
    is_active: Boolean
}

-- A compute node of the grid (ores_compute_hosts_tbl): a wrapper
-- registered with the serving environment, heartbeating over NATS.
entity ComputeHost {
    id: String
    external_id: String        -- the node's self-chosen id, e.g. "clever-echidna"
    display_name: String
    location: String?
    cpu_count: Integer
    ram_mb: Integer
    gpu_type: String?
    last_rpc_time: Timestamp?
    credit_total: Decimal
    modified_by: String
    recorded_at: Timestamp

    -- Derived: three missed 30s heartbeats declare the host offline.
    -- No column exists; the drain-time checks read this property.
    online: last_rpc_time != null and last_rpc_time >= now - config.heartbeat_timeout
}

-- One per-node telemetry sample (ores_node_samples_tbl), produced by
-- the grid monitor; grid-stats renders the per-node table from it.
entity HostTelemetry {
    host: ComputeHost
    sampled_at: Timestamp
    seconds_since_hb: Integer    -- heartbeat age in seconds
    tasks_completed: Integer
    tasks_failed: Integer
    input_bytes_fetched: Integer
    output_bytes_uploaded: Integer
}

-- A collection of jobs dispatched together from the shell
-- (ores_compute_batches_tbl).
entity Batch {
    id: String
    external_ref: String
    -- Free-text column, default `open`. The lifecycle verbs drive it;
    -- values outside the set below (e.g. `closed`, from earlier
    -- flows) exist in the data and render read-only.
    status: `open` | `dispatched` | `drained`
    -- Shell-side marker, set by add-batch --smoke. No column; the
    -- smoke script identifies its batch by this flag.
    is_smoke_test: Boolean
    -- Shell-side: the job list is session knowledge, not a column.
    -- Dispatch reads it back to create one workunit per job.
    jobs: List<Job>
    -- The shared input bundle, uploaded once at dispatch; the
    -- workunits reference its uri.
    input_bundle: Bundle?

    workunits: Workunit with batch = this

    -- Every workunit has a canonical result
    -- (ores_compute_workunits_tbl canonical_result_id); the batch can
    -- then drain.
    all_terminal: workunits.all(w => w.canonical_result_id != null)

    transitions status {
        `open` -> `dispatched`
        `dispatched` -> `drained`
        terminal: `drained`
    }
}

-- One unit of work dispatched to the grid (ores_compute_workunits_tbl).
-- There is no status or host column: assignment is invisible to the
-- shell, and completion is observable only through the results a node
-- submits (canonical_result_id).
entity Workunit {
    id: String
    batch: Batch
    app_version: ComputeAppVersion
    input_uri: String
    config_uri: String?
    priority: Integer
    target_redundancy: Integer
    canonical_result_id: String?
    modified_by: String
    recorded_at: Timestamp
}

-- The outcome of one workunit, submitted by the node that ran it
-- (ores_compute_results_tbl). The outcome column is nullable; the
-- rules below always set it.
entity Result {
    id: String
    workunit: Workunit
    host: ComputeHost
    server_state: Integer
    outcome: `success` | `client_error` | `no_reply`?
    output_uri: String?
    error_message: String?
    received_at: Timestamp
    modified_by: String
    recorded_at: Timestamp
}

-- ------------------------------------------------------------
-- Value Types
-- ------------------------------------------------------------

-- One unit of dispatchable work inside a batch. Each job becomes one
-- workunit when dispatched. Shell-side: labels are session knowledge;
-- the workunit row stores no label.
value Job {
    label: String
}

-- One storage bundle: the shared input bundle of a batch, uploaded
-- once at dispatch, or the output bundle a node uploaded with a
-- result.
value Bundle {
    uri: String
}

-- ------------------------------------------------------------
-- Contracts
-- ------------------------------------------------------------

contract BundleTransfer {
    fetch_input: (workunit: Workunit) -> Bundle
    fetch_output: (result: Result) -> Bundle

    @invariant UploadedBundleIsFetchable
        -- Whatever the node uploaded is exactly what the download
        -- returns: fetch_output(result) yields the same bytes as the
        -- node's output upload, and fetch_input(workunit) yields the
        -- batch's dispatch bundle.
}

-- ------------------------------------------------------------
-- Rules
-- ------------------------------------------------------------

-- The operator creates a batch of jobs, optionally as a smoke test.
rule AddBatch {
    when: OperatorAddsBatch(operator, id, external_ref, jobs, is_smoke_test)
    requires: jobs.count >= 1
    -- The smoke size bounds apply at creation: the batch row stores no
    -- job list, so no invariant can check the count afterwards.
    requires: not is_smoke_test
        or (jobs.count >= config.smoke_min_jobs and jobs.count <= config.smoke_max_jobs)
    ensures: Batch.created(
        id: id,
        external_ref: external_ref,
        jobs: jobs,
        is_smoke_test: is_smoke_test,
        status: `open`
    )
}

-- Dispatch uploads one input bundle for the whole batch, then creates
-- one workunit per job. Every workunit shares the bundle URI.
rule DispatchBatch {
    when: OperatorDispatchesBatch(operator, batch, app_version, input_bundle)
    requires: batch.status = `open`
    ensures: batch.status = `dispatched`
    ensures: batch.input_bundle = input_bundle
    for job in batch.jobs:
        ensures: Workunit.created(
            batch: batch,
            app_version: app_version,
            input_uri: input_bundle.uri,
            priority: 1,
            target_redundancy: 1
        )
}

-- A node heartbeats; the grid records it. The online property follows
-- from last_rpc_time and the heartbeat timeout.
rule RecordHeartbeat {
    when: HostHeartbeatReceived(host, timestamp)
    ensures: host.last_rpc_time = timestamp
}

-- A node reports the outcome of a workunit it ran. Success makes the
-- result canonical; a client error does not terminalize the workunit,
-- the grid may retry it (target_redundancy governs the copies).
rule RecordResult {
    when: ResultSubmitted(workunit, host, outcome, output_uri?)
    ensures: Result.created(
        workunit: workunit,
        host: host,
        outcome: outcome,
        output_uri: output_uri
    )
    if outcome = `success`:
        ensures: workunit.canonical_result_id != null
}

-- The batch drains when every workunit has a canonical result. For a
-- smoke batch, draining is also the "did all engines kick in" check:
-- every host online at the drain transition must have at least one
-- result in the batch, or the batch cannot drain. A host that comes
-- back online after the run does not trip this check.
rule BatchDrains {
    when: batch: Batch.all_terminal
    requires: batch.status = `dispatched`
    for h in ComputeHosts where batch.is_smoke_test and h.online:
        requires: (Result where workunit.batch = batch and host = h).count >= 1
    ensures: batch.status = `drained`
}

-- An offline host can be removed from the grid.
rule RemoveHost {
    when: OperatorDeletesHost(operator, host)
    requires: host.online = false
    ensures: not exists host
}

-- Downloads fetch the batch's shared input bundle for a workunit.
rule FetchInputBundle {
    when: OperatorDownloadsInput(operator, workunit)
    requires: workunit.input_uri != ""
    ensures: InputBundleFetched(
        operator: operator,
        workunit: workunit,
        bundle: BundleTransfer.fetch_input(workunit)
    )
}

-- Downloads fetch the result's output bundle from compute storage.
rule FetchOutputBundle {
    when: OperatorDownloadsOutput(operator, result)
    requires: result.output_uri != null
    ensures: OutputBundleFetched(
        operator: operator,
        result: result,
        bundle: BundleTransfer.fetch_output(result)
    )
}

-- ------------------------------------------------------------
-- Invariants
-- ------------------------------------------------------------

-- A drained smoke batch reports only successful outcomes.
invariant SmokeTestAllOutcomesSuccess {
    for b in Batches where b.is_smoke_test and b.status = `drained`:
        (Result where workunit.batch = b).all(r => r.outcome = `success`)
}

-- ------------------------------------------------------------
-- Surfaces
-- ------------------------------------------------------------

surface ComputeGridShell {
    facing operator: GridOperator

    contracts:
        demands BundleTransfer

    -- The exposure is exactly the column set of each codegen table
    -- renderer: what the list verbs print.
    exposes:
        for app in ComputeApps:
            app.id
            app.name
            app.description
            app.modified_by
            app.recorded_at
            for v in app.versions:
                v.id
                v.wrapper_version
                v.engine_version
                v.min_ram_mb
                v.modified_by
                v.recorded_at
        for p in Platforms:
            p.id
            p.code
            p.display_name
            p.description
            p.os_family
            p.cpu_arch
            p.abi
            p.is_active
        for h in ComputeHosts:
            h.id
            h.external_id
            h.display_name
            h.location
            h.cpu_count
            h.ram_mb
            h.gpu_type
            h.last_rpc_time
            h.credit_total
            h.modified_by
            h.recorded_at
        for t in HostTelemetry:
            t.host.id
            t.seconds_since_hb
            t.tasks_completed
            t.tasks_failed
            t.input_bytes_fetched
            t.output_bytes_uploaded
        for b in Batches:
            b.id
            b.external_ref
            b.status
            b.modified_by
            b.recorded_at
        for w in Workunits:
            w.id
            w.batch.id
            w.app_version.id
            w.input_uri
            w.config_uri
            w.priority
            w.target_redundancy
            w.modified_by
            w.recorded_at
        for r in Results:
            r.id
            r.workunit.id
            r.host.id
            r.server_state
            r.outcome
            r.output_uri
            r.error_message
            r.received_at
            r.modified_by
            r.recorded_at

    provides:
        OperatorAddsBatch(operator, id, external_ref, jobs, is_smoke_test)
        OperatorDispatchesBatch(operator, batch, app_version, input_bundle)
        OperatorDeletesHost(operator, host)
        OperatorDownloadsInput(operator, workunit)
        OperatorDownloadsOutput(operator, result)
        -- Observed from the grid (external inputs), not initiated by
        -- the shell; they ground the heartbeat and drain rules.
        ResultSubmitted(workunit, host, outcome, output_uri?)
        HostHeartbeatReceived(host, timestamp)

    @guarantee ReadVerbsAreNonDestructive
        -- The list verbs never change grid state: apps, app versions,
        -- platforms, hosts, batches, workunits and results are
        -- presented as stored.

    @guarantee ReadVerbsRenderFromGeneratedTables
        -- Every entity the surface exposes renders through its codegen
        -- table renderer (*_table_io); the shell never formats a row
        -- itself. Platform lacks a renderer today, so list-platforms
        -- prints raw rows until the ores.compute drift task generates
        -- it; the story's reconciliation task then streams the table
        -- (2026-08-10).

    @guarantee DispatchSharesOneInputBundle
        -- All workunits of a dispatched batch reference the same
        -- input bundle URI, uploaded once at dispatch.
}

-- Decisions (2026-08-10), answering the story's design points:
--   Q1 "did all engines kick in": captured as a drain-time check on
--     BatchDrains -- a smoke batch cannot drain while a host online
--     at the drain transition has no result in the batch -- plus the
--     SmokeTestAllOutcomesSuccess invariant. The smoke script polls
--     grid stats until the batch drains, then the property is the
--     assertion. The check runs at the drain transition, so a host
--     that comes back online after the run does not trip it.
--   Q2 shared vs per-job inputs: one shared input bundle per batch,
--     uploaded once at dispatch. Per-job inputs add no coverage value
--     to the smoke test and multiply storage traffic.
--   Q3 offline threshold: 90s, three missed 30s heartbeats.
--   Q4 smoke size: 10-20 jobs -- config bounds, enforced at add-batch
--     time: the batch row stores no job list, so a state invariant
--     cannot check the count after creation.
--   Q5 table support: every exposed entity must have a codegen table
--     renderer. Platform lacks one today, so list-platforms prints
--     raw rows (provisional) and the story's reconciliation task
--     swaps them for the generated renderer once the ores.compute
--     drift task lands; the other four verbs stream their tables
--     now.
--   Q6 weed round: entities reconciled with the implemented model
--     (domain structs and SQL columns). host.online is a derived
--     property (no column); workunit has no status or host -- completion
--     is observed through canonical_result_id; the host telemetry
--     fields moved to HostTelemetry (grid-stats reads node samples);
--     enum literals are backtick-quoted, matching the FOMC spec
--     convention.
