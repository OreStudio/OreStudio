title Rates family — proposed relational model (target)

hide circle
skinparam linetype ortho

package "The anchor" {
  entity ores_trading_trades_tbl #E8E8E8 {
    * tenant_id : uuid <<PK>>
    * id : uuid <<PK>>
    --
    * party_id : uuid
      counterparty_id : uuid
    * trade_type : text
    * counterparty_scope : text
    * booking_nature : text
    * entry_channel : text
  }
}

package "Proposed family tables" {
  entity ores_trading_rate_instruments_tbl <<temporal>> #C6F0D8 {
    * tenant_id : uuid <<PK, FK>>
    * trade_id : uuid <<PK, FK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
    * party_id : uuid <<FK>>
    * trade_type_code : text
    * trade_activity_id : uuid <<FK>>
      start_date : date
      maturity_date : date
      description : text
    * modified_by : text
    * performed_by : text
    * change_reason_code : text
    * change_commentary : text
  }

  entity ores_trading_swap_legs_tbl <<temporal>> #C6F0D8 {
    * tenant_id : uuid <<PK, FK>>
    * trade_id : uuid <<PK, FK>>
    * leg_number : int <<PK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
    * party_id : uuid
    * trade_activity_id : uuid <<FK>>
    * leg_type_code : text
    * day_count_fraction_code : text
    * business_day_convention_code : text
    * payment_frequency_code : text
      floating_index_code : text
      fixed_rate : numeric
      spread : numeric
    * notional : numeric
    * currency : text
  }

  entity ores_trading_swap_leg_amounts_tbl <<temporal>> #C6F0D8 {
    * tenant_id : uuid <<PK>>
    * trade_id : uuid <<PK, FK>>
    * leg_number : int <<PK, FK>>
    * sequence_number : int <<PK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
    * trade_activity_id : uuid <<FK>>
    * start_date : date
    * end_date : date
    * amount : numeric
  }

  entity ores_trading_swap_leg_rates_tbl <<temporal>> #C6F0D8 {
    * tenant_id : uuid <<PK>>
    * trade_id : uuid <<PK, FK>>
    * leg_number : int <<PK, FK>>
    * sequence_number : int <<PK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
    --
    * version : int
    * trade_activity_id : uuid <<FK>>
    * start_date : date
    * end_date : date
      fixed_rate : numeric
      spread : numeric
  }

  entity ores_trading_fra_instruments_tbl <<temporal>> #C6F0D8 {
    * tenant_id : uuid <<PK>>
    * trade_id : uuid <<PK, FK>>
    * valid_from : timestamptz <<PK>>
    * valid_to : timestamptz <<PK>>
