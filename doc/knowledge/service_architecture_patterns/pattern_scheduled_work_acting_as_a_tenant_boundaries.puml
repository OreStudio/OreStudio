@startuml

title Scheduled Work Acting as a Tenant: the pattern at each boundary


skinparam componentStyle rectangle
actor person
component "owning service" as owner
component "IAM" as iam
component "scheduler" as sched
component "workflow engine" as engine
component "step service\n[run token cache]" as step
component "data owner" as data
component "further service" as further
database "store\n(row-level security)" as db

person --> owner : Access Token\n(the person's session)
owner --> iam : Grant Management\n(create, revoke; relayed person)
sched --> owner : Client Credentials\n(trigger)
owner --> engine : start message\n(grant id, run id; no token)
engine --> step : step command\n(grant id, run id)
step --> iam : Token Exchange\n(own token + grant id)
step --> data : run token\n(Authorization)
data --> further : Token Relay\n(the run token)
data --> db : tenant T, party P
@enduml
