@startuml

package "ores.http.server" {
  [ores.http.vault] as vault_routes
  [ores.http.api] as http_api
  [ores.http.nats] as http_nats
}

package "ores.vault.service" {
  [vault.v1.ops.write] as write_op
  [vault.v1.ops.resolve] as resolve_op
}

http_api --> vault_routes : routes
vault_routes --> http_nats : forward a request
vault_routes --> write_op : sealed value, caller's token
vault_routes --> resolve_op : as the gateway, own token

@enduml
