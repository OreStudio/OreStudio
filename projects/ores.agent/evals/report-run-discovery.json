          "expect": {
            "tool": "read_fx_spot",
            "statuses": [
              "ok",
              "stale"
            ],
            "evidenceOrder": [
              "find_trades",
              "read_fx_spot"
            ],
            "contains": [
              "1.0552",
              "2016-12-30"
            ],
            "resultChecks": [
              {
                "path": "evidence.0.rows.0.id",
                "equals": "11111111-1111-4111-8111-000000000005"
              }
            ]
          }
        }
