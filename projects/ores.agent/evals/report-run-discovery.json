            {
              "tool": "enable_tools",
              "arguments": {
                "groups": [
                  "market"
                ]
              }
            },
            {
              "tool": "read_fx_spot",
              "arguments": {
                "baseCurrency": "EUR",
                "quoteCurrency": "USD",
                "provider": "ore",
                "asOf": "2016-12-30"
              }
