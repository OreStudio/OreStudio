@startuml

title ores.ore.api Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace ore #F2F2F2 {
        namespace messaging #F2F2F2 {
            class ore_import_execute_request <<struct>> {
                +request_id : string
                +import_choices_json : string
                +correlation_id : string
                +bearer_token : string
            }
            class ore_import_execute_result <<struct>> {
                +success : bool
                +message : string
                +correlation_id : string
                +item_errors : vector<ore_import_item_error>
                +saved_currency_iso_codes : vector<string>
                +saved_portfolio_ids : vector<string>
                +saved_book_ids : vector<string>
                +saved_trade_external_ids : vector<string>
            }
            class ore_import_rollback_request <<struct>> {
                +correlation_id : string
                +bearer_token : string
                +saved_currency_iso_codes : vector<string>
                +saved_portfolio_ids : vector<string>
                +saved_book_ids : vector<string>
                +saved_trade_external_ids : vector<string>
            }
            class ore_import_item_error <<struct>> {
                +source_file : string
                +item_id : string
                +message : string
            }
            class ore_import_request <<struct>> {
                +request_id : string
                +import_choices_json : string
                +correlation_id : string
            }
            class ore_import_response <<struct>> {
                +success : bool
                +message : string
                +item_errors : vector<ore_import_item_error>
                +correlation_id : string
                +workflow_instance_id : string
            }
        }
        namespace net #F2F2F2 {
            class ore_storage <<struct>> {
            }
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---

' --- What the part contracts to ---
'
' Every messaging type is a flat struct carrying a request, a response, or a
' shared payload. Each request names its reply through `using response_type`
' and carries `static constexpr std::string_view nats_subject`, so the subject
' and the reply type travel with the request and no caller spells either one.
'
' The part publishes three subjects:
'
'   workflow.v1.ops.ore_import                the import workflow trigger
'   ore.v1.ore.import.{execute,rollback}  the import saga steps
'
' The saga subjects double the component name: ore.v1.ops.ore_import_execute
' says "ore" twice.

ores::ore::messaging::ore_import_request --> ores::ore::messaging::ore_import_response : response_type
ores::ore::messaging::ore_import_execute_request --> ores::ore::messaging::ore_import_execute_result : response_type

' --- What the automated pass cannot see ---
'
' Two things in this part have no class to hang off, so they are absent from
' the picture above and from every picture the generator will produce:
'
'   include/ores.ore.api/workflow/ore_import_workflow.hpp
'       register_ore_import_workflow(registry). ores.workflow.core calls it
'       from its registrar, which is the one place another component reaches
'       into this part.
'   include/ores.ore.api/export.hpp
'       the visibility macros; the part builds a shared library.
'
' The .cpp files under src/ build ores.ore.api.lib, so the part is not
' header-only even though the diagram shows only declarations.

' Local Variables:
' compile-command: "java -Djava.awt.headless=true -DPLANTUML_SECURITY_PROFILE=UNSECURE -DPLANTUML_LIMIT_SIZE=65535 -jar /usr/share/plantuml/plantuml.jar ores.ore.api.puml"
' End:
@enduml
