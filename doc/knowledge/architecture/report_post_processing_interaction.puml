@startuml
actor "Workflow engine" as wf
participant "Compute node" as node
participant "Object storage" as store
participant "ores.ore" as ore
participant "Reporting service" as reporting
participant "Market data service" as marketdata
database "Result tables" as results
database "Market state table" as state

== The engine prices, and the node leaves its output behind ==
node -> node : run the engine
node -> store : upload the output archive
note right of node : the whole output directory, as the run's audit blob

== Post-processing reads it ==
wf -> reporting : post_process_results(run)
reporting -> store : fetch each result's output archive
store --> reporting : the archive
reporting -> reporting : unpack it, and list the files
reporting -> ore : read_metrics, read_cashflows, by family
ore --> reporting : the run's figures
reporting -> results : one bulk insert for each family, in one transaction
reporting -> marketdata : store_market_state(run, archive locations, run token)
marketdata -> store : fetch the archive
marketdata -> ore : index_payload, by family
ore --> marketdata : the headings, the row count, the key values
marketdata -> state : one row for each market-state file
reporting --> wf : the run's result summary

== What a screen reads ==
actor "Screen" as screen
screen -> results : the run result view
note right of results : the view names each engine heading once
@enduml
