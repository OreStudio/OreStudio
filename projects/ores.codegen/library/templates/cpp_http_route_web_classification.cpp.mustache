boost::asio::awaitable<http_response> {{unit}}_routes::handle_list(const http_request& req,
                                                                   nats_client& session) {
    try {
        auto rows = {{unit}}_rows(req, session);
        std::map<std::string, std::string> labels;
        try {
            labels = classification_routes::labels_of(req, session, "{{code_domain}}");
        } catch (const rr::refusal& refusal) {
            BOOST_LOG_SEV(lg(), warn) << "Labels could not be read: " << refusal.message;
        } catch (const std::exception& e) {
            BOOST_LOG_SEV(lg(), warn) << "Labels could not be read: " << e.what();
        }
        cr::sort_rows(rows);
        std::string out = "{\"rows\":[";
        for (std::size_t i = 0; i < rows.size(); ++i) {
            if (i != 0)
                out += ",";
            out += cr::row_json(rows[i], labels);
        }
        co_return http_response::json(out + "]}");
    } catch (const rr::refusal& refusal) {
        co_return rr::answer(refusal);
    } catch (const std::exception& e) {
        BOOST_LOG_SEV(lg(), error) << e.what();
        co_return http_response::api_error(http_status::bad_gateway, "internal",
                                           std::string(rr::unanswered));
    }
}

