@startuml

title ores.geo Component

set namespaceSeparator ::

namespace ores #F2F2F2 {
    namespace geo #F2F2F2 {
        namespace service #F2F2F2 {
            class geolocation_result <<struct>> {
                +country_code : string
            }
            enum geolocation_error {
                address_not_found
                lookup_failed
                invalid_address
            }
            class geolocation_service {
                -ctx_ : database::context
                +geolocation_service(ctx : database::context)
                +lookup(ip : const address&) : expected<geolocation_result, geolocation_error>
                +lookup(ip_string : const string&) : expected<geolocation_result, geolocation_error>
            }
            geolocation_service ..> geolocation_result : produces
            geolocation_service ..> geolocation_error : produces
        }
    }
}

' --- manual: everything below this line is hand-authored; the script preserves it ---
