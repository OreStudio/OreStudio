@startuml

title Identity: from the start message to the settled run

actor "the caller\n(the shell)" as caller
participant "the process manager\n(the engine)" as engine
database "the run and step rows" as db
participant "the fixture's handler\n(the workflow service)" as handler
participant "the client" as client

caller -> engine : start identity_workflow\n(the steps, and the outcome each declares)
engine -> db : create the run\n(with the step count and the resolved steps)

loop each declared step, in order

    engine -> db : record the step in progress
    engine -> handler : workflow.v1.identity.step\n(the step, the instance, the tenant)
    handler -> handler : wait, if the request asked it to
    handler -> engine : workflow.v1.events.step-completed\n(completed, completed with warnings, or failed)
    engine -> db : record the outcome

end

alt every step completed

    engine -> db : record the run completed

else a step failed

    engine -> db : record the step failed

    opt a completed step declared a compensation
        engine -> handler : workflow.v1.identity.compensate\n(the step, the instance, the tenant)
        handler -> engine : workflow.v1.events.step-completed
        engine -> db : record the compensation,\nat a negative step index
    end

    engine -> db : record the run compensated,\nand clear the run's error

end

client -> db : read the progress\n(workflow.v1.instances.steps)

@enduml
