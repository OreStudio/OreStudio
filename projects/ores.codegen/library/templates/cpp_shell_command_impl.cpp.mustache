void {{entity_singular}}_commands::register_commands(cli::Menu& root_menu,
                                                     nats_client& session,
                                                     pagination_context& pagination) {
    auto {{entity_plural}}_menu = std::make_unique<cli::Menu>("{{entity_plural}}");

    {{entity_plural}}_menu->Insert(
        "get",
        [&session, &pagination](std::ostream& out) {
            process_get_{{entity_plural}}(
                std::ref(out), std::ref(session), std::ref(pagination));
        },
        "Retrieve {{entity_plural_words}} from the server (paginated)");

    pagination.register_list_callback("{{entity_plural}}", [&session, &pagination](
                                                               std::ostream& out) {
        process_get_{{entity_plural}}(out, session, pagination);
    });

    {{entity_plural}}_menu->Insert(
        "add",
        [&session](std::ostream& out, std::vector<std::string> args) {
            process_add_{{entity_singular}}(std::ref(out), std::ref(session), args);
        },
        "Add {{entity_singular_words}} ({{#primary_key.columns}}{{#is_user_supplied}}{{column}} "
        "{{/is_user_supplied}}{{/primary_key.columns}}{{#columns}}{{#is_user_supplied}}{{name}} "
        "{{/is_user_supplied}}{{/columns}}change_reason_code "
        "\"change_commentary\")");

    {{entity_plural}}_menu->Insert(
        "delete",
        [&session](std::ostream& out, std::string id) {
            process_delete_{{entity_singular}}(std::ref(out), std::ref(session), std::move(id));
        },
        "Delete {{entity_singular_words}} by {{primary_key.column}}");

    {{entity_plural}}_menu->Insert(
        "history",
        [&session](std::ostream& out, std::string id) {
            process_get_{{entity_singular}}_history(
                std::ref(out), std::ref(session), std::move(id));
        },
        "Show {{entity_singular_words}}'s version history");

    root_menu.Insert(std::move({{entity_plural}}_menu));
}

void {{entity_singular}}_commands::process_get_{{entity_plural}}(
    std::ostream& out, nats_client& session, pagination_context& pagination) {
    BOOST_LOG_SEV(lg(), debug) << "Initiating get {{entity_singular_words}} request.";

    auto& state = pagination.state_for("{{entity_plural}}");

    {{component}}::messaging::get_{{entity_plural}}_request req;
    req.offset = state.current_offset;
    req.limit = pagination.page_size();

    auto result = do_auth_request<{{component}}::messaging::get_{{entity_plural}}_response>(
        out, session, "{{component}}.v1.{{entity_plural}}.list", req);
    if (!result)
        return;

    state.total_count = result->total_available_count;
    pagination.set_last_entity("{{entity_plural}}");

    BOOST_LOG_SEV(lg(), info) << "Successfully retrieved " << result->{{entity_plural}}.size()
                              << " {{entity_plural_words}}.";
    out << result->{{entity_plural}} << std::endl;

    const auto page = (state.current_offset / pagination.page_size()) + 1;
    const auto total_pages =
        state.total_count > 0 ?
            ((state.total_count + pagination.page_size() - 1) / pagination.page_size()) :
            1;
    out << "\nPage " << page << " of " << total_pages << " ("
        << result->{{entity_plural}}.size() << " of " << state.total_count << " total)"
        << std::endl;
}

