class ores::utility::generation::generation_engine {
    +generation_engine(seed : uint64_t)
    +generation_engine()
    +seed() : uint64_t
    +random_int(min : int, max : int) : int
    +random_bool(probability : double) : bool
    +pick(items : vector<T>) : const T&
    +generate_uuid() : boost::uuids::uuid
    +past_timepoint(years_back : int) : time_point
    +alphanumeric(length : size_t) : string
}
note right of "ores::utility::generation::generation_engine"
Every random value in the tree comes from this one mt19937_64,
seeded at construction. generate_uuid builds the RFC 9562 version
and variant bits itself; it does not use uuid_v7_generator.
end note

class ores::utility::generation::generation_context {
    +generation_context(seed : uint64_t, initial : entries)
    +generation_context(initial : entries)
    +child(overrides : entries) : generation_context
    +engine() : generation_engine&
    +env() : const generation_environment&
    +generate_uuid() : boost::uuids::uuid
    +random_int(min : int, max : int) : int
    +alphanumeric(length : size_t) : string
}
note right of "ores::utility::generation::generation_context"
An engine plus a scoped environment. child() shares the engine,
so a nested context continues the same random sequence.
end note

class ores::utility::generation::generation_environment {
    +generation_environment(initial : entries)
    +generation_environment(parent : shared_ptr<const generation_environment>, overrides : entries)
