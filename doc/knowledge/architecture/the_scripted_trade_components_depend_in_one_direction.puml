@startuml
@startuml

title The scripted trade components: every dependency points down, and the parser knows no trading type

skinparam componentStyle rectangle
skinparam shadowing false

package "ores.shell" {
  [ores.shell.trading] as shell
}
package "ores.synthetic" {
  [ores.synthetic.core] as synthetic
}
package "ores.ore" {
  [ores.ore.core] as ore
}
package "ores.trading" {
  [ores.trading.service] as service
  [ores.trading.core] as core
  [ores.trading.api] as api
  [ores.trading.scripting] as scripting
}
[ores.utility / ores.platform] as utility
[Boost Spirit] as spirit
[ores.web] as web

service --> core
core --> api
api --> scripting
ore --> api
synthetic --> api
shell --> api
shell --> scripting
scripting --> utility
scripting --> spirit
web ..> service : booking API, over the gateway

note right of scripting
  ORE's grammar, syntax tree,
  printer and static analysis,
  copied with ORE's authorship.
  parse, inputs_of, print.
end note

@enduml
