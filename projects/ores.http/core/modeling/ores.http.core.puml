                    +path : string
                    +size : uintmax_t
                    +compressed : bool
                }
                class bundle_manifest {
                    -root_ : filesystem::path
                    -entries_ : unordered_map<string, bundle_entry>
                    +bundle_manifest(filesystem::path root)
                    +find(const string& path) : [[nodiscard]] const bundle_entry*
                    +root() : [[nodiscard]] const filesystem::path&
                    +size() : [[nodiscard]] size_t
                }
                class change_routes {
                    -hub_ : shared_ptr<stream::change_hub>
                    -keep_alive_ : chrono::milliseconds
                    -watches_ : stream::watch_registry
                    +change_routes(shared_ptr<stream::change_hub> hub, chrono::milliseconds keep_alive)
                    +register_routes(shared_ptr<http::net::router> router, shared_ptr<http::openapi::endpoint_registry> registry) : void
                    +read_watches(const string& body) : [[nodiscard]] static optional<unordered_set<string>>
                    +watches() : [[nodiscard]] stream::watch_registry&
                    -lg() : auto&
                    -handle_changes(const domain::http_request& req, bool watched) : boost::asio::awaitable<domain::http_response>
                    -handle_watch(const domain::http_request& req) : domain::http_response
                }
                class storage_entry_source {
                    -entry_ : storage::filesystem::archive_reader::stream
                    +storage_entry_source(filesystem::path packed, string_view name, uint64_t offset, uint64_t length)
                    +found() : [[nodiscard]] bool
                    +size() : [[nodiscard]] optional<uint64_t>
                    +read(span<char> into) : size_t
                }
                class storage_file_source {
                    +to_end : static constexpr uint64_t
                    -path_ : filesystem::path
                    -in_ : ifstream
                    -size_ : uint64_t
                    -produced_ : uint64_t
                    +storage_file_source(filesystem::path path, uint64_t offset, uint64_t length)
                    +size() : [[nodiscard]] optional<uint64_t>
                    +read(span<char> into) : size_t
                }
                class storage_routes {
                    -store_ : storage::filesystem::local_store
                    -auth_service_ : shared_ptr<iam::service::authorization_service>
                    -max_upload_bytes_ : uint64_t
