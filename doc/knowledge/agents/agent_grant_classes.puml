@startuml

title An agent grant belongs to one person and is redeemed by keys

hide circle
skinparam classAttributeIconSize 0

class account <<ores.iam>> {
  id
  tenant_id
}

class agent_grant {
  id
  tenant_id
  account_id
  party_id
  agent_name
  scope : read_only | read_write
  created_at
  expires_at
  revoked_at
  created_through : key | oauth
}

class agent_key {
  id
  grant_id
  prefix
  hash
  created_at
  last_used_at
}

class oauth_client <<later>> {
  client_id
  grant_id
  redirect_uri
}

account "1" -- "0..*" agent_grant : consents >
agent_grant "1" -- "0..*" agent_key : redeemed by >
agent_grant "1" -- "0..1" oauth_client : redeemed by >

note bottom of agent_key
  The key is shown once, when it is made.
  Only its prefix and its hash are kept.
end note

@enduml
