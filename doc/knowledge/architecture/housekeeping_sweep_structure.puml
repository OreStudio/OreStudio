@startuml

title Housekeeping: the parts and what the executor touches

actor "Operator" as op

component "Housekeeping screen" as screen
database "Policy table\n(declared bounds)" as policy
component "Scheduler" as sched
component "Housekeeping executor" as exec
component "Policy telemetry" as tel

collections "Database stores\nchunks and rows" as db
collections "Object store\nkey prefixes" as obj
collections "Node caches\nengine distributions" as cache
collections "Scratch\njob directories" as scratch

op --> screen : declares, enables
screen --> policy : writes
sched --> exec : fires on a configured cadence
exec --> policy : reads the enabled policies
exec --> db : drops chunks, deletes rows
exec --> obj : deletes a prefix
exec --> cache : prunes a content-addressed copy
exec --> scratch : releases after the upload
exec --> tel : records the size and the outcome
tel --> screen : shows the size beside its policy

@enduml
