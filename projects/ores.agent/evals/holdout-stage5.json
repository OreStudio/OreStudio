    {
      "id": "holdout-scope-npv",
      "group": "reporting",
      "intent": "read_scope_valuation",
      "profiles": [
        "replay",
        "model",
        "live"
      ],
      "capability": {
        "status": "available"
      },
      "turns": [
        {
          "message": "Read the stored base-currency value of book \"Fixture FX Book\" on 2026-11-06 in run 11111111-1111-4111-8111-000000000007.",
          "replay": [
            {
              "tool": "summarize_scope_results",
              "arguments": {
                "scopeType": "book",
                "scope": "Fixture FX Book",
                "runId": "11111111-1111-4111-8111-000000000007",
                "measure": "npv_base",
                "valuationDate": "2026-11-06"
              }
            }
          ],
          "expect": {
            "tool": "summarize_scope_results",
            "contains": [
              "0.3 GBP"
            ],
            "statuses": [
              "ok"
            ],
            "arguments": {
              "scope": "Fixture FX Book",
              "runId": "11111111-1111-4111-8111-000000000007",
              "valuationDate": "2026-11-06"
            },
            "checks": [
              {
                "path": "total.figure",
                "equals": "0.3"
              },
              {
                "path": "total.currency",
                "equals": "GBP"
              },
              {
                "path": "coverage.expectedTradeCount",
                "equals": 2
              }
            ]
          }
        }
      ],
