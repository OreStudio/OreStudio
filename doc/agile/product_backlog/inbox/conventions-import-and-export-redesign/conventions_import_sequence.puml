@startuml

title Conventions import by family

actor "ores.shell" as shell
participant "ores.refdata" as refdata
database "PostgreSQL" as db

shell -> refdata : begin_conventions_import\n{import_id, party_id, families[]}
refdata -> db : insert import row\n(state = staging, expires_at)
refdata --> shell : import_id

loop every family the file carries
    shell -> refdata : stage_conventions_<family>\n{import_id, sequence, items[]}
    refdata -> db : insert staged items\n(one local transaction)
    refdata --> shell : staged count
end

shell -> refdata : commit_conventions_import {import_id}
refdata -> db : select import for update
refdata -> db : verify required families present
refdata -> db : apply families in registry order\n(one transaction)
refdata -> db : pg_notify fires on commit only
refdata -> db : import.state = applied
refdata --> shell : save result + per-family counts

@enduml
